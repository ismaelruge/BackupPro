<div class="container-fluid py-5">
    <!-- Hero Section -->
    <div class="row justify-content-center mb-5">
        <div class="col-lg-10">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden hero-gradient">
                <div class="card-body p-5 text-center text-white">
                    <div class="mb-4">
                        <i class="bi bi-shield-lock-fill" style="font-size: 5rem;"></i>
                    </div>
                    <h1 class="display-3 fw-bold mb-3">
                        ¡Bienvenido a BackupPro!
                    </h1>
                    <p class="lead mb-4 fs-4">
                        Tu herramienta confiable para mantener tus datos seguros y respaldados.
                    </p>
                    <button id="btnBackups" class="btn btn-light btn-lg px-5 py-3 shadow-lg rounded-pill">
                        <i class="bi bi-play-circle-fill me-2"></i> Ejecutar Backups Ahora
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Status Section -->
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Spinner oculto -->
            <div id="spinner" class="text-center mb-4" style="display: none;">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-4">
                        <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                            <span class="visually-hidden">Ejecutando...</span>
                        </div>
                        <h5 class="text-muted">Creando copias de seguridad...</h5>
                        <p class="text-muted small mb-0">Por favor, espere mientras se completa el proceso</p>
                    </div>
                </div>
            </div>

            <!-- Contenedor de alertas -->
            <div id="alertContainer"></div>
        </div>
    </div>

    <!-- Features Section -->
    <div class="row justify-content-center mt-5">
        <div class="col-lg-10">
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4 hover-card">
                        <div class="card-body">
                            <div class="mb-3">
                                <i class="bi bi-database-fill-check text-primary" style="font-size: 3rem;"></i>
                            </div>
                            <h5 class="card-title fw-bold">Backups Automáticos</h5>
                            <p class="card-text text-muted">
                                Programa y ejecuta respaldos de bases de datos de forma automática y confiable.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4 hover-card">
                        <div class="card-body">
                            <div class="mb-3">
                                <i class="bi bi-graph-up-arrow text-success" style="font-size: 3rem;"></i>
                            </div>
                            <h5 class="card-title fw-bold">Monitoreo en Tiempo Real</h5>
                            <p class="card-text text-muted">
                                Visualiza el estado de tus respaldos y accede al historial completo de operaciones.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4 hover-card">
                        <div class="card-body">
                            <div class="mb-3">
                                <i class="bi bi-gear-fill text-warning" style="font-size: 3rem;"></i>
                            </div>
                            <h5 class="card-title fw-bold">Fácil Configuración</h5>
                            <p class="card-text text-muted">
                                Configura múltiples bases de datos y personaliza los parámetros según tus necesidades.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("btnBackups").addEventListener("click", async function () {
            const btn = this;
            const spinner = document.getElementById("spinner");
            const alertContainer = document.getElementById("alertContainer");

            // Limpiar alertas anteriores
            alertContainer.innerHTML = "";

            // Deshabilitar botón y mostrar spinner
            btn.disabled = true;
            btn.innerHTML = `<span class="spinner-border spinner-border-sm me-2"></span> Ejecutando...`;
            spinner.style.display = "block";

            try {
                // Llamada al método del controlador
                const response = await fetch('/Home/EjecutarBackups', { method: 'POST' });

                if (response.ok) {
                    // Mostrar alerta de éxito
                    alertContainer.innerHTML = `
                        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-4" role="alert">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-check-circle-fill fs-4 me-3"></i>
                                <div>
                                    <h6 class="mb-0 fw-bold">¡Éxito!</h6>
                                    <small>Los backups se ejecutaron correctamente.</small>
                                </div>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    `;
                } else {
                    // Mostrar alerta de error
                    alertContainer.innerHTML = `
                        <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-4" role="alert">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                                <div>
                                    <h6 class="mb-0 fw-bold">Error</h6>
                                    <small>Hubo un error al ejecutar los backups.</small>
                                </div>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    `;
                }
            } catch (error) {
                alertContainer.innerHTML = `
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-4" role="alert">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                            <div>
                                <h6 class="mb-0 fw-bold">Error inesperado</h6>
                                <small>Ocurrió un error al procesar la solicitud.</small>
                            </div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                `;
            }

            // Restaurar botón y ocultar spinner
            spinner.style.display = "none";
            btn.disabled = false;
            btn.innerHTML = `<i class="bi bi-play-circle-fill me-2"></i> Ejecutar Backups Ahora`;
        });
    </script>
}