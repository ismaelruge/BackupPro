    // Botón para conectar con Google
    document.getElementById('btnConnectGoogle')?.addEventListener('click', function() {
        // Abrir ventana popup para autenticación OAuth2
        const width = 600;
        const height = 700;
        const left = (screen.width / 2) - (width / 2);
        const top = (screen.height / 2) - (height / 2);

        const authWindow = window.open(
            '/StorageType/GoogleDriveAuth',
            'GoogleDriveAuth',
            `width=${width},height=${height},top=${top},left=${left},menubar=no,toolbar=no,location=no,status=no`
        );

        if (!authWindow) {
            showToast('error', 'No se pudo abrir la ventana de autenticación. Verifica que los popups no estén bloqueados.');
            return;
        }

        // Escuchar mensaje del callback (solo una vez por conexión)
        const messageHandler = function(event) {
            // Verificar que el mensaje viene de nuestra aplicación
            if (event.origin !== window.location.origin) {
                return;
            }

            if (event.data && typeof event.data === 'object') {
                if (event.data.success) {
                    // Autenticación exitosa
                    const email = event.data.email;
                    const accessToken = event.data.accessToken;

                    // Actualizar UI
                    document.getElementById('googleEmail').value = email;
                    driveExplorerData.accessToken = accessToken;

                    // Habilitar botón de explorar
                    document.getElementById('btnExploreDrive').disabled = false;

                    showToast('success', 'Conectado exitosamente con Google Drive');

                    // Remover listener después de recibir el mensaje
                    window.removeEventListener('message', messageHandler);
                } else if (event.data.success === false) {
                    showToast('error', 'Error de autenticación: ' + (event.data.message || 'Error desconocido'));

                    // Remover listener después de recibir el mensaje
                    window.removeEventListener('message', messageHandler);
                }
            }
        };

        window.addEventListener('message', messageHandler);

        // Timeout por si el usuario cierra la ventana sin completar la autenticación
        setTimeout(() => {
            if (authWindow && !authWindow.closed) {
                // La ventana sigue abierta después de 5 minutos, limpiar listener
                window.removeEventListener('message', messageHandler);
            }
        }, 300000); // 5 minutos
    });

