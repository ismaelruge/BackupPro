        const loading = document.getElementById('driveFolderLoading');
        const error = document.getElementById('driveFolderError');
        const list = document.getElementById('driveFolderList');
        const empty = document.getElementById('driveFolderEmpty');

        // Mostrar loading
        loading.classList.remove('d-none');
        error.classList.add('d-none');
        list.innerHTML = '';
        empty.classList.add('d-none');

        try {
            const response = await fetch('/StorageType/ListDriveFolders', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    accessToken: driveExplorerData.accessToken,
                    parentId: parentId || ''
                })
            });

            const data = await response.json();

            loading.classList.add('d-none');

            if (data.success) {
                if (data.folders && data.folders.length > 0) {
                    data.folders.forEach(folder => {
                        const folderItem = createDriveFolderItem(folder);
                        list.appendChild(folderItem);
                    });
                } else {
                    empty.classList.remove('d-none');
                }

                // Actualizar path actual
                driveExplorerData.currentParentId = parentId || '';
            } else {
                error.classList.remove('d-none');
                document.getElementById('driveFolderErrorMessage').textContent = data.message;
            }
        } catch (err) {
            loading.classList.add('d-none');
            error.classList.remove('d-none');
            document.getElementById('driveFolderErrorMessage').textContent = 'Error de conexión: ' + err.message;
        }
    }

    // Función para crear elemento de carpeta Drive
    function createDriveFolderItem(folder) {
        const item = document.createElement('a');
        item.href = '#';
        item.className = 'list-group-item list-group-item-action drive-folder-item';
        item.innerHTML = `
            <div class="d-flex align-items-center">
                <i class="bi bi-folder-fill text-primary me-3" style="font-size: 1.5rem;"></i>
                <div class="flex-grow-1">
                    <h6 class="mb-0">${folder.name}</h6>
                    <small class="text-muted">Modificado: ${new Date(folder.modifiedTime).toLocaleString()}</small>
                </div>
                <i class="bi bi-chevron-right text-muted"></i>
            </div>
        `;

        // Click simple: navegar dentro de la carpeta
        item.addEventListener('click', function(e) {
            e.preventDefault();
            navigateToFolder(folder.id, folder.name);
        });

        return item;
    }

    // Función para navegar a una carpeta
    function navigateToFolder(folderId, folderName) {
        // Guardar carpeta actual en el stack
        driveExplorerData.folderStack.push({
            id: driveExplorerData.currentParentId,
            name: driveExplorerData.currentPath.split('/').pop(),
            path: driveExplorerData.currentPath
        });

        // Actualizar estado
        driveExplorerData.currentParentId = folderId;
        driveExplorerData.currentPath += '/' + folderName;

        // Actualizar breadcrumb
        updateDriveBreadcrumb();

        // Actualizar ruta seleccionada
        document.getElementById('driveSelectedPath').value = driveExplorerData.currentPath;

        // Cargar subcarpetas
        loadDriveFolders(folderId);
    }

    // Función para actualizar breadcrumb de Drive
    function updateDriveBreadcrumb() {
        const breadcrumb = document.getElementById('driveBreadcrumb');
        breadcrumb.innerHTML = '';

        const parts = driveExplorerData.currentPath.split('/').filter(p => p);

        parts.forEach((part, index) => {
            const item = document.createElement('li');

            if (index === parts.length - 1) {
                item.className = 'breadcrumb-item active';
                item.textContent = part;
            } else {
                item.className = 'breadcrumb-item breadcrumb-link';
                item.textContent = part;
                item.style.cursor = 'pointer';

                item.addEventListener('click', () => {
                    // Navegar hacia atrás en el breadcrumb
                    const targetIndex = index;
                    const levelsBack = parts.length - 1 - targetIndex;

                    // Retroceder en el stack
                    for (let i = 0; i < levelsBack; i++) {
                        if (driveExplorerData.folderStack.length > 0) {
                            const prev = driveExplorerData.folderStack.pop();
                            driveExplorerData.currentParentId = prev.id;
                            driveExplorerData.currentPath = prev.path;
                        }
                    }

                    updateDriveBreadcrumb();
                    document.getElementById('driveSelectedPath').value = driveExplorerData.currentPath;
                    loadDriveFolders(driveExplorerData.currentParentId);
                });
            }

            if (index === 0) {
                const icon = document.createElement('i');
                icon.className = 'bi bi-google me-1';
                item.prepend(icon);
            }

            breadcrumb.appendChild(item);
        });
    }

    // Botón para seleccionar ruta de Drive
    document.getElementById('btnSelectDrivePath')?.addEventListener('click', function() {
        const selectedPath = document.getElementById('driveSelectedPath').value;

        if (!selectedPath) {
            showToast('warning', 'Por favor, selecciona una carpeta.');
            return;
        }

        // Asignar al campo correspondiente
        if (driveExplorerData.isEditMode) {
            document.getElementById('editFolderPath').value = selectedPath;
        } else {
            document.getElementById('folderPath').value = selectedPath;
        }

        // Cerrar modal
        const explorerModal = bootstrap.Modal.getInstance(document.getElementById('driveExplorerModal'));
        explorerModal.hide();
    });

    // Botón para crear nueva carpeta en Drive - abrir modal
    document.getElementById('btnCreateDriveFolder')?.addEventListener('click', function() {
        // Mostrar la ubicación actual en el modal
        document.getElementById('createDriveFolderLocation').textContent = driveExplorerData.currentPath;

        // Limpiar el input
        document.getElementById('newDriveFolderName').value = '';

        // Abrir modal
        const createFolderModal = new bootstrap.Modal(document.getElementById('createDriveFolderModal'));
        createFolderModal.show();
    });

    // Confirmar creación de carpeta Drive
    document.getElementById('btnConfirmCreateDriveFolder')?.addEventListener('click', async function() {
        const folderName = document.getElementById('newDriveFolderName').value.trim();

        if (!folderName) {
            showToast('warning', 'Por favor, ingresa un nombre para la carpeta.');
            return;
        }

        // Deshabilitar botón mientras se crea
        const btn = this;
        const originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Creando...';

        try {
            const response = await fetch('/StorageType/CreateDriveFolder', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    accessToken: driveExplorerData.accessToken,
                    parentId: driveExplorerData.currentParentId,
                    folderName: folderName
                })
            });

            const data = await response.json();

            if (data.success) {
                // Cerrar modal
                const createFolderModal = bootstrap.Modal.getInstance(document.getElementById('createDriveFolderModal'));
                createFolderModal.hide();

                // Mostrar mensaje de éxito
                showToast('success', 'Carpeta creada exitosamente en Google Drive');

                // Recargar el directorio actual para mostrar la nueva carpeta
                loadDriveFolders(driveExplorerData.currentParentId);
            } else {
                showToast('error', 'Error al crear carpeta: ' + data.message);
            }
        } catch (error) {
            showToast('error', 'Error de conexión: ' + error.message);
        } finally {
            // Restaurar botón
            btn.disabled = false;
            btn.innerHTML = originalHtml;
        }
    });

    // Permitir crear carpeta Drive con Enter en el input
    document.getElementById('newDriveFolderName')?.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            document.getElementById('btnConfirmCreateDriveFolder').click();
        }
    });

    // ========== GOOGLE DRIVE AUTHENTICATION ==========

    // Variable global para almacenar el access token de Google Drive
    let googleDriveAccessToken = null;
    let googleDriveEmail = null;

    // Botón para conectar con Google Drive (modal agregar)
    document.getElementById('btnConnectGoogle')?.addEventListener('click', function() {
        authenticateWithGoogleDrive();
    });

    // Botón para conectar con Google Drive (modal editar)
    document.getElementById('btnEditConnectGoogle')?.addEventListener('click', function() {
        authenticateWithGoogleDrive(true);
    });

    // Función para autenticar con Google Drive
    function authenticateWithGoogleDrive(isReconnect = false) {
        // Abrir ventana de autenticación de Google
        const authWindow = window.open(
            '/StorageType/GoogleDriveAuth',
            'GoogleDriveAuth',
            'width=600,height=700,left=200,top=100'
        );

        // Escuchar mensaje de la ventana de autenticación
        window.addEventListener('message', function handleAuthMessage(event) {
            // Verificar que el mensaje viene de nuestro dominio
            if (event.origin !== window.location.origin) {
                return;
            }

            // Verificar que es el mensaje de autenticación de Google Drive
            if (!event.data || typeof event.data.success === 'undefined') {
                return;
            }

            // Remover el listener después de recibir el mensaje
            window.removeEventListener('message', handleAuthMessage);

            if (event.data.success) {
                googleDriveAccessToken = event.data.accessToken;
                googleDriveEmail = event.data.email;

                // Actualizar también el driveExplorerData para que funcione el explorador
                driveExplorerData.accessToken = event.data.accessToken;

                if (isReconnect) {
                    // Actualizar el email en el modal de editar
                    document.getElementById('editGoogleEmail').value = googleDriveEmail;
                    showToast('success', 'Reconexión exitosa con Google Drive: ' + googleDriveEmail);

                    // Habilitar el botón de explorar
                    document.getElementById('btnExploreEditDrive').disabled = false;
                } else {
                    // Actualizar el email en el modal de agregar
                    document.getElementById('googleEmail').value = googleDriveEmail;
                    showToast('success', 'Conexión exitosa con Google Drive: ' + googleDriveEmail);

                    // Habilitar el botón de explorar
                    document.getElementById('btnExploreDrive').disabled = false;
                }
            } else {
                showToast('error', 'Error de autenticación: ' + (event.data.message || 'Error desconocido'));
            }
        });

        // Verificar si la ventana fue cerrada sin completar la autenticación
        const checkWindowClosed = setInterval(function() {
            if (authWindow.closed) {
                clearInterval(checkWindowClosed);
                if (!googleDriveAccessToken) {
                    showToast('warning', 'Autenticación cancelada');
                }
            }
        }, 500);
    }

    // ========== ONEDRIVE AUTHENTICATION ==========

    // Variable global para almacenar el access token de OneDrive
    let oneDriveAccessToken = null;
    let oneDriveEmail = null;

    // Variables globales para OneDrive Explorer
    let oneDriveExplorerData = {
        accessToken: '',
        currentItemId: '',
        currentPath: '/Mi unidad',
        folderStack: [], // Stack para navegación: [{id, name, path}, ...]
        isEditMode: false
    };

    // Botón para conectar con OneDrive (modal agregar)
    document.getElementById('btnConnectOneDrive')?.addEventListener('click', function() {
        authenticateWithOneDrive();
    });

    // Botón para conectar con OneDrive (modal editar)
    document.getElementById('btnEditConnectOneDrive')?.addEventListener('click', function() {
        authenticateWithOneDrive(true);
    });

    // Función para autenticar con OneDrive
    function authenticateWithOneDrive(isReconnect = false) {
        // Abrir ventana de autenticación de Microsoft
        const authWindow = window.open(
            '/StorageType/OneDriveAuth',
            'OneDriveAuth',
            'width=600,height=700,left=200,top=100'
        );

        // Escuchar mensaje de la ventana de autenticación
        window.addEventListener('message', function handleAuthMessage(event) {
            // Verificar que el mensaje viene de nuestro dominio
            if (event.origin !== window.location.origin) {
                return;
            }

            // Verificar que es el mensaje de autenticación de OneDrive
            if (!event.data || typeof event.data.success === 'undefined') {
                return;
            }

            // Remover el listener después de recibir el mensaje
            window.removeEventListener('message', handleAuthMessage);

            if (event.data.success) {
                oneDriveAccessToken = event.data.accessToken;
                oneDriveEmail = event.data.email;

                // Actualizar también el oneDriveExplorerData para que funcione el explorador
                oneDriveExplorerData.accessToken = event.data.accessToken;

                if (isReconnect) {
                    // Actualizar el email en el modal de editar
                    document.getElementById('editOneDriveEmail').value = oneDriveEmail;
                    showToast('success', 'Reconexión exitosa con OneDrive: ' + oneDriveEmail);

                    // Habilitar el botón de explorar
                    document.getElementById('btnExploreEditOneDrive').disabled = false;
                } else {
                    // Actualizar el email en el modal de agregar
                    document.getElementById('oneDriveEmail').value = oneDriveEmail;
                    showToast('success', 'Conexión exitosa con OneDrive: ' + oneDriveEmail);

                    // Habilitar el botón de explorar
                    document.getElementById('btnExploreOneDrive').disabled = false;
                }
            } else {
                showToast('error', 'Error de autenticación: ' + (event.data.message || 'Error desconocido'));
            }
        });

        // Verificar si la ventana fue cerrada sin completar la autenticación
        const checkWindowClosed = setInterval(function() {
            if (authWindow.closed) {
                clearInterval(checkWindowClosed);
                if (!oneDriveAccessToken) {
                    showToast('warning', 'Autenticación cancelada');
                }
            }
        }, 500);
    }

    // Botón para explorar OneDrive (modo agregar)
    document.getElementById('btnExploreOneDrive')?.addEventListener('click', function() {
        openOneDriveExplorer(false);
    });

    // Botón para explorar OneDrive (modo editar)
    document.getElementById('btnExploreEditOneDrive')?.addEventListener('click', function() {
        openOneDriveExplorer(true);
    });

    // Función para abrir el explorador de OneDrive
    function openOneDriveExplorer(isEditMode) {
        if (!oneDriveExplorerData.accessToken) {
            showToast('warning', 'Por favor, conéctate con OneDrive primero.');
            return;
        }

        oneDriveExplorerData.isEditMode = isEditMode;
        oneDriveExplorerData.currentItemId = '';
        oneDriveExplorerData.currentPath = '/Mi unidad';
        oneDriveExplorerData.folderStack = [];

        // Resetear UI
        document.getElementById('oneDriveSelectedPath').value = '/Mi unidad';

        // Abrir modal
        const explorerModal = new bootstrap.Modal(document.getElementById('oneDriveExplorerModal'));
        explorerModal.show();

        // Cargar carpetas raíz
        loadOneDriveFolders('');
    }

    // Función para cargar carpetas de OneDrive
    async function loadOneDriveFolders(itemId) {
        const loading = document.getElementById('oneDriveFolderLoading');
        const error = document.getElementById('oneDriveFolderError');
        const list = document.getElementById('oneDriveFolderList');
        const empty = document.getElementById('oneDriveFolderEmpty');

        // Mostrar loading
        loading.classList.remove('d-none');
        error.classList.add('d-none');
        list.innerHTML = '';
        empty.classList.add('d-none');

        try {
            const response = await fetch('/StorageType/ListOneDriveFolders', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    accessToken: oneDriveExplorerData.accessToken,
                    itemId: itemId || ''
                })
            });

            const data = await response.json();

            loading.classList.add('d-none');

            if (data.success) {
                if (data.folders.length === 0) {
                    empty.classList.remove('d-none');
                } else {
                    data.folders.forEach(folder => {
                        const item = createOneDriveFolderItem(folder);
                        list.appendChild(item);
                    });
                }
            } else {
                error.classList.remove('d-none');
                document.getElementById('oneDriveFolderErrorMessage').textContent = data.message;
            }
        } catch (ex) {
            loading.classList.add('d-none');
            error.classList.remove('d-none');
            document.getElementById('oneDriveFolderErrorMessage').textContent = 'Error de conexión: ' + ex.message;
        }
    }

    // Función para crear un elemento de carpeta OneDrive
    function createOneDriveFolderItem(folder) {
        const item = document.createElement('a');
        item.href = '#';
        item.className = 'list-group-item list-group-item-action onedrive-folder-item';

        item.innerHTML = `
            <div class="d-flex align-items-center">
                <i class="bi bi-folder me-3 text-primary fs-5"></i>
                <div class="flex-grow-1">
                    <div class="fw-semibold">${folder.name}</div>
                    <small class="text-muted">Modificado: ${new Date(folder.lastModifiedDateTime).toLocaleDateString()}</small>
                </div>
                <i class="bi bi-chevron-right text-muted"></i>
            </div>
        `;

        // Click simple: navegar dentro de la carpeta
        item.addEventListener('click', function(e) {
            e.preventDefault();
            navigateToOneDriveFolder(folder.id, folder.name);
        });

        return item;
    }

    // Función para navegar a una carpeta de OneDrive
    function navigateToOneDriveFolder(itemId, folderName) {
        // Guardar carpeta actual en el stack
        oneDriveExplorerData.folderStack.push({
            id: oneDriveExplorerData.currentItemId,
            name: oneDriveExplorerData.currentPath.split('/').pop() || 'Mi unidad',
            path: oneDriveExplorerData.currentPath
        });

        // Actualizar datos actuales
        oneDriveExplorerData.currentItemId = itemId;
        oneDriveExplorerData.currentPath = oneDriveExplorerData.currentPath + '/' + folderName;

        // Actualizar UI
        document.getElementById('oneDriveCurrentPath').textContent = oneDriveExplorerData.currentPath;
        document.getElementById('oneDriveSelectedPath').value = oneDriveExplorerData.currentPath;
        document.getElementById('btnOneDriveBack').disabled = false;

        // Cargar subcarpetas
        loadOneDriveFolders(itemId);
    }

    // Botón "Atrás" en el explorador
    document.getElementById('btnOneDriveBack')?.addEventListener('click', function() {
        if (oneDriveExplorerData.folderStack.length === 0) return;

        // Obtener carpeta anterior del stack
        const previous = oneDriveExplorerData.folderStack.pop();

        // Actualizar datos actuales
        oneDriveExplorerData.currentItemId = previous.id;
        oneDriveExplorerData.currentPath = previous.path;

        // Actualizar UI
        document.getElementById('oneDriveCurrentPath').textContent = oneDriveExplorerData.currentPath;
        document.getElementById('oneDriveSelectedPath').value = oneDriveExplorerData.currentPath;

        // Deshabilitar botón si llegamos a la raíz
        if (oneDriveExplorerData.folderStack.length === 0) {
            this.disabled = true;
        }

        // Cargar carpetas del nivel anterior
        loadOneDriveFolders(previous.id);
    });

    // Botón "Seleccionar Carpeta"
    document.getElementById('btnSelectOneDriveFolder')?.addEventListener('click', function() {
        const selectedPath = document.getElementById('oneDriveSelectedPath').value;

        if (oneDriveExplorerData.isEditMode) {
            document.getElementById('editOneDriveFolderPath').value = selectedPath;
        } else {
            document.getElementById('oneDriveFolderPath').value = selectedPath;
        }

        // Cerrar modal
        bootstrap.Modal.getInstance(document.getElementById('oneDriveExplorerModal')).hide();
        showToast('success', 'Ruta seleccionada: ' + selectedPath);
    });

    // Formulario crear carpeta OneDrive
    document.getElementById('createOneDriveFolderForm')?.addEventListener('submit', async function(e) {
        e.preventDefault();

        const folderName = document.getElementById('newOneDriveFolderName').value.trim();
        if (!folderName) {
            showToast('error', 'El nombre de la carpeta no puede estar vacío');
            return;
        }

        const btn = document.getElementById('btnConfirmCreateOneDriveFolder');
        const originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Creando...';

        try {
            const response = await fetch('/StorageType/CreateOneDriveFolder', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    accessToken: oneDriveExplorerData.accessToken,
                    parentId: oneDriveExplorerData.currentItemId || '',
                    folderName: folderName
                })
            });

            const data = await response.json();

            if (data.success) {
                showToast('success', 'Carpeta creada exitosamente');

                // Cerrar modal de crear carpeta
                bootstrap.Modal.getInstance(document.getElementById('createOneDriveFolderModal')).hide();

                // Limpiar campo
                document.getElementById('newOneDriveFolderName').value = '';

                // Recargar lista de carpetas
                loadOneDriveFolders(oneDriveExplorerData.currentItemId);
            } else {
                showToast('error', 'Error al crear carpeta: ' + data.message);
            }
        } catch (error) {
            showToast('error', 'Error de conexión: ' + error.message);
        } finally {
            btn.disabled = false;
            btn.innerHTML = originalHtml;
        }
    });

    // Permitir crear carpeta OneDrive con Enter en el input
    document.getElementById('newOneDriveFolderName')?.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            document.getElementById('btnConfirmCreateOneDriveFolder').click();
        }
    });

</script>
