    // Función para cargar directorios de Blob
    async function loadBlobDirectories(path) {
        blobExplorerData.currentPath = path;
        showBlobFolderState('loading');

        try {
            const response = await fetch('/StorageType/ListBlobDirectories', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    connectionString: blobExplorerData.connectionString,
                    containerName: blobExplorerData.selectedContainer,
                    path: path
                })
            });

            const data = await response.json();

            if (data.success) {
                displayBlobDirectories(data.directories, data.currentPath);
                updateBlobBreadcrumb(data.currentPath);
            } else {
                showBlobFolderState('error', data.message);
            }
        } catch (error) {
            showBlobFolderState('error', 'Error de conexión: ' + error.message);
        }
    }

    // Función para mostrar estados de carpetas
    function showBlobFolderState(state, message = '') {
        const loading = document.getElementById('blobFolderLoading');
        const error = document.getElementById('blobFolderError');
        const folderList = document.getElementById('blobFolderList');
        const empty = document.getElementById('blobFolderEmpty');

        loading.classList.add('d-none');
        error.classList.add('d-none');
        folderList.classList.add('d-none');
        empty.classList.add('d-none');

        switch(state) {
            case 'loading':
                loading.classList.remove('d-none');
                break;
            case 'error':
                error.classList.remove('d-none');
                document.getElementById('blobFolderErrorMessage').textContent = message;
                break;
            case 'empty':
                empty.classList.remove('d-none');
                folderList.classList.remove('d-none');
                break;
            case 'success':
                folderList.classList.remove('d-none');
                break;
        }
    }

    // Función para mostrar directorios Blob
    function displayBlobDirectories(directories, currentPath) {
        const folderList = document.getElementById('blobFolderList');
        folderList.innerHTML = '';

        // Botón para volver atrás (si no estamos en raíz del contenedor)
        if (currentPath) {
            const parentPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
            const backItem = createBlobFolderItem('..', parentPath, true);
            folderList.appendChild(backItem);
        }

        // Mostrar carpetas
        if (directories.length === 0) {
            showBlobFolderState('empty');
            updateSelectedBlobPath(currentPath);
        } else {
            showBlobFolderState('success');
            directories.forEach(dir => {
                const item = createBlobFolderItem(dir.name, dir.fullPath, false);
                folderList.appendChild(item);
            });
        }

        updateSelectedBlobPath(currentPath);
    }

