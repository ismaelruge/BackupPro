@model IEnumerable<BackupPro.Models.SftpStorage>
@{
    ViewData["Title"] = "Sftp Storage";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">
            <!-- Card principal -->
            <div class="card shadow-lg border-0 rounded-4">
                <!-- Header -->
                <div class="card-header bg-primary text-white border-0 rounded-top-4 py-4">
                    <div class="text-center">
                        <i class="bi bi-cloud-arrow-up fs-1 mb-3"></i>
                        <h3 class="fw-bold mb-2">Tipos de Almacenamiento</h3>
                        <p class="mb-0 opacity-75">Configura múltiples destinos donde se guardarán tus backups</p>
                    </div>
                </div>

                <!-- Cuerpo con pestañas -->
                <div class="card-body p-4">
                    <!-- Nav Tabs -->
                    <ul class="nav nav-pills nav-fill mb-4" id="storageTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <a class="nav-link" id="google-tab" role="tab" asp-area="" asp-controller="GoogleDriveStorage" asp-action="Index">
                                <i class="bi bi-google me-2"></i>Google Drive
                            </a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link" id="onedrive-tab" role="tab" asp-area="" asp-controller="OneDriveStorage" asp-action="Index">
                                <i class="bi bi-microsoft me-2"></i>OneDrive
                            </a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link" id="blob-tab" role="tab" asp-area="" asp-controller="BlobStorage" asp-action="Index">
                                <i class="bi bi-cloud me-2"></i>Azure Blob
                            </a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link" id="ftp-tab" role="tab" asp-area="" asp-controller="FtpStorage" asp-action="Index">
                                <i class="bi bi-hdd-network me-2"></i>FTP
                            </a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link active" id="sftp-tab" role="tab" asp-area="" asp-controller="SftpStorage" asp-action="Index">
                                <i class="bi bi-shield-lock me-2"></i>SFTP
                            </a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link" id="local-tab" role="tab" asp-area="" asp-controller="LocalStorage" asp-action="Index">
                                <i class="bi bi-folder me-2"></i>Local
                            </a>
                        </li>
                    </ul>

                    <!-- Tab Content -->
                    <div class="tab-content" id="storageTabContent">

                        <!-- SFTP -->
                        <div class="tab-pane fade show active" id="sftp" role="tabpanel">
                            <div class="text-center mb-4">
                                <i class="bi bi-shield-lock text-primary" style="font-size: 3rem;"></i>
                                <h4 class="mt-3">Servidor SFTP</h4>
                                <p class="text-muted">Configura múltiples servidores SFTP (transferencia segura por SSH)</p>
                            </div>

                            <!-- Lista de configuraciones -->
                            <div class="mb-4">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="fw-semibold mb-0">
                                        <i class="bi bi-gear-fill me-2 text-primary"></i>Configuraciones Activas
                                    </h6>
                                    <span class="badge bg-primary rounded-pill">@Model.Count() configuradas</span>
                                </div>

                                @if (!Model.Any())
                                {
                                    <div class="alert alert-info" role="alert">
                                        <i class="bi bi-info-circle me-2"></i>
                                        No hay configuraciones SFTP registradas. Haz clic en "Agregar Nueva Configuración" para comenzar.
                                    </div>
                                }
                                else
                                {
                                    @foreach (var config in Model)
                                    {
                                        <!-- Configuración -->
                                        <div class="card mb-3 border-0 shadow-sm">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <div class="flex-grow-1">
                                                        <h6 class="mb-2 fw-semibold">
                                                            <span class="text-primary">@config.ConfigurationName</span>
                                                            <span class="text-muted fw-normal"> - @config.Host:@config.Port</span>
                                                        </h6>
                                                        <div class="ms-4">
                                                            <div class="mb-1">
                                                                <i class="bi bi-person me-2 text-muted"></i>
                                                                <small class="text-muted">Usuario: @config.Username</small>
                                                            </div>
                                                            <div class="mb-1">
                                                                <i class="bi bi-folder me-2 text-muted"></i>
                                                                <span class="text-muted">Ruta:</span>
                                                                <code class="ms-1">@config.RemotePath</code>
                                                            </div>
                                                            <span class="badge bg-success mt-1">
                                                                <i class="bi bi-check-circle me-1"></i>Activo
                                                            </span>
                                                        </div>
                                                    </div>
                                                    <div>
                                                        <button class="btn btn-sm btn-outline-primary rounded-pill me-2"
                                                                onclick="openEditModal(@config.Id)"
                                                                aria-label="Editar configuración SFTP">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-danger rounded-pill"
                                                                onclick="openDeleteModal(@config.Id, '@config.ConfigurationName', '@config.Host:@config.Port', '@config.Username', '@config.RemotePath')"
                                                                aria-label="Eliminar configuración SFTP">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>

                            <!-- Botón agregar nueva configuración -->
                            <div class="d-grid">
                                <button type="button" class="btn btn-outline-primary btn-lg rounded-pill" data-bs-toggle="modal" data-bs-target="#addSftpModal">
                                    <i class="bi bi-plus-circle me-2"></i>Agregar Nueva Configuración
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Información adicional -->
            <div class="alert alert-info rounded-4 mt-4 shadow-sm" role="alert">
                <div class="d-flex align-items-center">
                    <i class="bi bi-info-circle-fill fs-3 me-3"></i>
                    <div>
                        <h6 class="mb-1 fw-semibold">Múltiples destinos</h6>
                        <p class="mb-0">Puedes configurar múltiples destinos del mismo tipo. Los backups se copiarán a todos los destinos configurados como activos.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Agregar SFTP -->
<div class="modal fade" id="addSftpModal" tabindex="-1" aria-labelledby="addSftpModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white border-0">
                <h5 class="modal-title" id="addSftpModalLabel">
                    <i class="bi bi-shield-lock me-2"></i>Agregar Configuración SFTP
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4">
                <form id="addSftpForm">
                    <div class="mb-3">
                        <label for="sftpConfigName" class="form-label fw-semibold">
                            <i class="bi bi-tag me-2 text-primary"></i>Nombre de Configuración
                        </label>
                        <input type="text" class="form-control" id="sftpConfigName" placeholder="Ej: Servidor SFTP Principal" required>
                        <div class="form-text">Dale un nombre descriptivo a esta configuración</div>
                    </div>
                    <div class="mb-3">
                        <label for="sftpHost" class="form-label fw-semibold">
                            <i class="bi bi-hdd-network me-2 text-primary"></i>Servidor SFTP
                        </label>
                        <input type="text" class="form-control" id="sftpHost" placeholder="sftp.servidor.com" required>
                        <div class="form-text">Dirección del servidor (sin el puerto)</div>
                    </div>
                    <div class="mb-3">
                        <label for="sftpPort" class="form-label fw-semibold">
                            <i class="bi bi-hdd-network me-2 text-primary"></i>Puerto
                        </label>
                        <input type="number" class="form-control" id="sftpPort" placeholder="22" value="22" min="1" max="65535" required>
                    </div>
                    <div class="mb-3">
                        <label for="sftpUsername" class="form-label fw-semibold">
                            <i class="bi bi-person me-2 text-primary"></i>Usuario
                        </label>
                        <input type="text" class="form-control" id="sftpUsername" placeholder="usuario_sftp" required>
                    </div>
                    <div class="mb-3">
                        <label for="sftpPassword" class="form-label fw-semibold">
                            <i class="bi bi-key me-2 text-primary"></i>Contraseña
                        </label>
                        <input type="password" class="form-control" id="sftpPassword" placeholder="••••••••" required>
                    </div>
                    <div class="mb-3">
                        <label for="sftpPath" class="form-label fw-semibold">
                            <i class="bi bi-folder me-2 text-primary"></i>Ruta en el Servidor
                        </label>
                        <input type="text" class="form-control" id="sftpPath" placeholder="/backups/principal" value="/" required>
                        <div class="form-text">Ruta donde se guardarán los backups en el servidor SFTP</div>
                    </div>
                    <div class="alert alert-warning rounded-3 mb-0" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <small><strong>Nota:</strong> Asegúrate de tener acceso y permisos de escritura en el servidor SFTP.</small>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 bg-light">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-2"></i>Cancelar
                </button>
                <button type="submit" form="addSftpForm" class="btn btn-primary rounded-pill">
                    <i class="bi bi-shield-lock me-2"></i>Conectar Servidor SFTP
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Editar SFTP -->
<div class="modal fade" id="editSftpModal" tabindex="-1" aria-labelledby="editSftpModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-warning text-dark border-0">
                <h5 class="modal-title" id="editSftpModalLabel">
                    <i class="bi bi-pencil-square me-2"></i>Editar Configuración SFTP
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4">
                <form id="editSftpForm">
                    <input type="hidden" id="editSftpId">
                    <input type="hidden" id="editSftpCurrentPassword">
                    <div class="mb-3">
                        <label for="editSftpConfigName" class="form-label fw-semibold">
                            <i class="bi bi-tag me-2 text-warning"></i>Nombre de Configuración
                        </label>
                        <input type="text" class="form-control" id="editSftpConfigName" required>
                    </div>
                    <div class="mb-3">
                        <label for="editSftpHost" class="form-label fw-semibold">
                            <i class="bi bi-hdd-network me-2 text-warning"></i>Servidor SFTP
                        </label>
                        <input type="text" class="form-control" id="editSftpHost" placeholder="sftp.servidor.com" required>
                        <div class="form-text">Dirección del servidor (sin el puerto)</div>
                    </div>
                    <div class="mb-3">
                        <label for="editSftpPort" class="form-label fw-semibold">
                            <i class="bi bi-hdd-network me-2 text-warning"></i>Puerto
                        </label>
                        <input type="number" class="form-control" id="editSftpPort" min="1" max="65535" required>
                    </div>
                    <div class="mb-3">
                        <label for="editSftpUsername" class="form-label fw-semibold">
                            <i class="bi bi-person me-2 text-warning"></i>Usuario
                        </label>
                        <input type="text" class="form-control" id="editSftpUsername" required>
                    </div>
                    <div class="mb-3">
                        <label for="editSftpPassword" class="form-label fw-semibold">
                            <i class="bi bi-key me-2 text-warning"></i>Contraseña
                        </label>
                        <input type="password" class="form-control" id="editSftpPassword" placeholder="••••••••">
                        <div class="form-text">Deja vacío para mantener la contraseña actual. Escribe una nueva para cambiarla.</div>
                    </div>
                    <div class="mb-3">
                        <label for="editSftpPath" class="form-label fw-semibold">
                            <i class="bi bi-folder me-2 text-warning"></i>Ruta en el Servidor
                        </label>
                        <input type="text" class="form-control" id="editSftpPath" required>
                        <div class="form-text">Ruta donde se guardarán los backups en el servidor SFTP</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 bg-light">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-2"></i>Cancelar
                </button>
                <button type="submit" form="editSftpForm" class="btn btn-warning rounded-pill">
                    <i class="bi bi-save me-2"></i>Guardar Cambios
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Eliminar SFTP -->
<div class="modal fade" id="deleteSftpModal" tabindex="-1" aria-labelledby="deleteSftpModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-danger text-white border-0">
                <h5 class="modal-title" id="deleteSftpModalLabel">
                    <i class="bi bi-exclamation-triangle me-2"></i>Confirmar Eliminación
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="deleteSftpId">
                <div class="text-center mb-4">
                    <div class="bg-danger bg-opacity-10 rounded-circle p-3 d-inline-flex mb-3">
                        <i class="bi bi-trash text-danger" style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="fw-semibold">¿Estás seguro de eliminar esta configuración?</h5>
                </div>
                <div class="bg-light rounded-3 p-3 mb-3">
                    <div class="mb-2">
                        <strong class="text-primary" id="deleteConfigName"></strong>
                        <span class="text-muted" id="deleteHostPort"></span>
                    </div>
                    <div class="text-muted">
                        <small>
                            <i class="bi bi-person me-2"></i>
                            Usuario: <code id="deleteUsername"></code>
                        </small>
                    </div>
                    <div class="text-muted">
                        <small>
                            <i class="bi bi-folder me-2"></i>
                            Ruta: <code id="deleteRemotePath"></code>
                        </small>
                    </div>
                </div>
                <div class="alert alert-danger rounded-3 mb-0" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <strong>Advertencia:</strong> Esta acción no se puede deshacer. Los backups existentes en el servidor SFTP no serán eliminados, solo se removerá la configuración de este sistema.
                </div>
            </div>
            <div class="modal-footer border-0 bg-light">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-2"></i>Cancelar
                </button>
                <button type="button" class="btn btn-danger rounded-pill" id="btnConfirmDelete">
                    <i class="bi bi-trash me-2"></i>Sí, Eliminar Configuración
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .nav-pills .nav-link {
        border-radius: 50rem;
        padding: 0.75rem 1.5rem;
        font-weight: 500;
        transition: all 0.3s ease;
    }

        .nav-pills .nav-link:hover {
            background-color: rgba(13, 110, 253, 0.1);
            transform: translateY(-2px);
        }

        .nav-pills .nav-link.active {
            background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
            box-shadow: 0 4px 6px rgba(13, 110, 253, 0.3);
        }

    .tab-pane {
        animation: fadeIn 0.3s ease-in;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .rounded-circle {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

<!-- Contenedor de toasts -->
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 2000;">
    <div id="successToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                <i class="bi bi-check-circle me-2"></i>
                <span id="successToastMessage"></span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
    <div id="errorToast" class="toast align-items-center text-white bg-danger border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                <i class="bi bi-exclamation-triangle me-2"></i>
                <span id="errorToastMessage"></span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
    <div id="warningToast" class="toast align-items-center text-white bg-warning border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                <i class="bi bi-info-circle me-2"></i>
                <span id="warningToastMessage"></span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<script>
    // Función helper para mostrar toasts
    function showToast(type, message) {
        const toastElement = document.getElementById(type + 'Toast');
        const messageElement = document.getElementById(type + 'ToastMessage');
        messageElement.textContent = message;

        const toast = new bootstrap.Toast(toastElement, {
            autohide: true,
            delay: 3000
        });
        toast.show();
    }

    // CRUD Operations

    // Crear nueva configuración SFTP
    document.getElementById('addSftpForm')?.addEventListener('submit', async function(e) {
        e.preventDefault();

        const data = {
            configurationName: document.getElementById('sftpConfigName').value,
            host: document.getElementById('sftpHost').value,
            port: parseInt(document.getElementById('sftpPort').value),
            username: document.getElementById('sftpUsername').value,
            password: document.getElementById('sftpPassword').value,
            remotePath: document.getElementById('sftpPath').value
        };

        try {
            const response = await fetch('/SftpStorage/Create', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                },
                body: JSON.stringify(data)
            });

            const result = await response.json();

            if (result.success) {
                showToast('success', result.message);
                bootstrap.Modal.getInstance(document.getElementById('addSftpModal')).hide();
                setTimeout(() => window.location.reload(), 1500);
            } else {
                showToast('error', result.message);
            }
        } catch (error) {
            showToast('error', 'Error de conexión: ' + error.message);
        }
    });

    // Abrir modal de editar y cargar datos
    async function openEditModal(id) {
        try {
            const response = await fetch(`/SftpStorage/GetById?id=${id}`);
            const result = await response.json();

            if (result.success) {
                const data = result.data;
                document.getElementById('editSftpId').value = data.id;
                document.getElementById('editSftpConfigName').value = data.configurationName;
                document.getElementById('editSftpHost').value = data.host;
                document.getElementById('editSftpPort').value = data.port;
                document.getElementById('editSftpUsername').value = data.username;
                document.getElementById('editSftpPassword').value = ''; // Dejar vacío para que el usuario pueda cambiarla
                document.getElementById('editSftpCurrentPassword').value = data.password; // Guardar contraseña actual en campo oculto
                document.getElementById('editSftpPath').value = data.remotePath;

                const modal = new bootstrap.Modal(document.getElementById('editSftpModal'));
                modal.show();
            } else {
                showToast('error', result.message);
            }
        } catch (error) {
            showToast('error', 'Error al cargar la configuración: ' + error.message);
        }
    }

    // Guardar cambios de edición
    document.getElementById('editSftpForm')?.addEventListener('submit', async function(e) {
        e.preventDefault();

        // Si el campo de contraseña visible está vacío, usar la contraseña actual
        let passwordToSend = document.getElementById('editSftpPassword').value;
        if (!passwordToSend) {
            passwordToSend = document.getElementById('editSftpCurrentPassword').value;
        }

        const data = {
            id: parseInt(document.getElementById('editSftpId').value),
            configurationName: document.getElementById('editSftpConfigName').value,
            host: document.getElementById('editSftpHost').value,
            port: parseInt(document.getElementById('editSftpPort').value),
            username: document.getElementById('editSftpUsername').value,
            password: passwordToSend,
            remotePath: document.getElementById('editSftpPath').value
        };

        try {
            const response = await fetch('/SftpStorage/Edit', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                },
                body: JSON.stringify(data)
            });

            const result = await response.json();

            if (result.success) {
                showToast('success', result.message);
                bootstrap.Modal.getInstance(document.getElementById('editSftpModal')).hide();
                setTimeout(() => window.location.reload(), 1500);
            } else {
                showToast('error', result.message);
            }
        } catch (error) {
            showToast('error', 'Error de conexión: ' + error.message);
        }
    });

    // Abrir modal de eliminar
    function openDeleteModal(id, name, hostPort, username, remotePath) {
        document.getElementById('deleteSftpId').value = id;
        document.getElementById('deleteConfigName').textContent = name;
        document.getElementById('deleteHostPort').textContent = ' - ' + hostPort;
        document.getElementById('deleteUsername').textContent = username;
        document.getElementById('deleteRemotePath').textContent = remotePath;

        const modal = new bootstrap.Modal(document.getElementById('deleteSftpModal'));
        modal.show();
    }

    // Confirmar eliminación
    document.getElementById('btnConfirmDelete')?.addEventListener('click', async function() {
        const id = document.getElementById('deleteSftpId').value;

        try {
            const response = await fetch('/SftpStorage/Delete?id=' + id, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                }
            });

            const result = await response.json();

            if (result.success) {
                showToast('success', result.message);
                bootstrap.Modal.getInstance(document.getElementById('deleteSftpModal')).hide();
                setTimeout(() => window.location.reload(), 1500);
            } else {
                showToast('error', result.message);
            }
        } catch (error) {
            showToast('error', 'Error de conexión: ' + error.message);
        }
    });
</script>
