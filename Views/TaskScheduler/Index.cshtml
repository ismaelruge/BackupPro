    // Ejecutar una tarea específica
    async function executeTask(taskId) {
        const result = await Swal.fire({
            title: '¿Ejecutar tarea ahora?',
            text: 'Se iniciará el proceso de backup inmediatamente',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: '<i class="bi bi-play-fill me-2"></i>Ejecutar',
            cancelButtonText: 'Cancelar',
            confirmButtonColor: '#198754',
            cancelButtonColor: '#6c757d'
        });

        if (result.isConfirmed) {
            Swal.fire({
                title: 'Ejecutando...',
                html: 'El backup está en proceso',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const response = await fetch('/TaskScheduler/ExecuteTask', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: `id=${taskId}&__RequestVerificationToken=${encodeURIComponent(token)}`
                });

                const data = await response.json();

                if (data.success) {
                    await Swal.fire('¡Éxito!', data.message, 'success');
                    location.reload();
                } else {
                    Swal.fire('Error', data.message, 'error');
                }
            } catch (error) {
                Swal.fire('Error', 'Error al ejecutar la tarea', 'error');
                console.error('Error:', error);
            }
        }
    }

