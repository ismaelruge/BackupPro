    // Pausar/Activar tarea
    async function toggleTask(taskId, isActive) {
        const action = isActive ? 'pausar' : 'activar';
        const actionUpper = isActive ? 'Pausar' : 'Activar';

        const result = await Swal.fire({
            title: `¿${actionUpper} tarea?`,
            text: isActive ? 'La tarea dejará de ejecutarse automáticamente' : 'La tarea se reanudará según su programación',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: `<i class="bi bi-${isActive ? 'pause' : 'play'}-fill me-2"></i>${actionUpper}`,
            cancelButtonText: 'Cancelar',
            confirmButtonColor: isActive ? '#ffc107' : '#198754',
            cancelButtonColor: '#6c757d'
        });

        if (result.isConfirmed) {
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const response = await fetch('/TaskScheduler/ToggleTask', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: `id=${taskId}&__RequestVerificationToken=${encodeURIComponent(token)}`
                });

                const data = await response.json();

                if (data.success) {
                    await Swal.fire('¡Hecho!', data.message, 'success');
                    location.reload();
                } else {
                    Swal.fire('Error', data.message, 'error');
                }
            } catch (error) {
                Swal.fire('Error', 'Error al cambiar el estado de la tarea', 'error');
                console.error('Error:', error);
            }
        }
    }

    // Editar tarea
    async function editTask(taskId) {
        try {
            const response = await fetch(`/TaskScheduler/GetById?id=${taskId}`);
            const result = await response.json();

            if (result.success) {
                const task = result.data;

                // Poblar el modal con los datos
                document.getElementById('edit_task_id').value = task.id;
                document.getElementById('edit_task_name').value = task.taskName;
                document.getElementById('edit_database_type').value = task.databaseType;
                document.getElementById('edit_storage_type').value = task.storageType;
                document.getElementById('edit_frequency_type').value = task.frequencyType;
                document.getElementById('edit_frequency_value').value = task.frequencyValue;
                document.getElementById('edit_is_active').checked = task.isActive;

                // Cargar databases y storages basándose en los tipos
                await loadDatabases('edit');
                await loadStorages('edit');

                // Seleccionar los valores específicos
                document.getElementById('edit_database_id').value = task.databaseId;
                document.getElementById('edit_storage_id').value = task.storageId;

                // Abrir el modal
                const modal = new bootstrap.Modal(document.getElementById('editTaskModal'));
                modal.show();
            } else {
                Swal.fire('Error', result.message, 'error');
            }
        } catch (error) {
            Swal.fire('Error', 'Error al cargar los datos de la tarea', 'error');
            console.error('Error:', error);
        }
    }

    // Form submission handlers
    document.getElementById('addTaskForm')?.addEventListener('submit', async function(e) {
        e.preventDefault();

        const submitBtn = document.getElementById('add_task_submit_btn');
        const originalText = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Creando...';

        try {
            const formData = new FormData(this);
            // Añadir el valor del checkbox IsActive
            const isActiveCheckbox = document.getElementById('add_is_active');
            formData.set('IsActive', isActiveCheckbox.checked);

            const response = await fetch('/TaskScheduler/Create', {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Accept': 'application/json'
                },
                body: new URLSearchParams(formData)
            });

            const data = await response.json();

            if (data.success) {
                await Swal.fire('¡Éxito!', data.message, 'success');
                location.reload();
            } else {
                showAlert('add_task_error_alert', 'add_task_error_message', data.message);
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            }
        } catch (error) {
            showAlert('add_task_error_alert', 'add_task_error_message', 'Error al crear la tarea');
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
            console.error('Error:', error);
        }
    });

    document.getElementById('editTaskForm')?.addEventListener('submit', async function(e) {
        e.preventDefault();

        const submitBtn = document.getElementById('edit_task_submit_btn');
        const originalText = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Actualizando...';

