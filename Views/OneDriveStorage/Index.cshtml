@model IEnumerable<BackupPro.Models.OneDriveStorage>
@{
    ViewData["Title"] = "Almacenamiento One Drive";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">
            <!-- Card principal -->
            <div class="card shadow-lg border-0 rounded-4">
                <!-- Header -->
                <div class="card-header bg-primary text-white border-0 rounded-top-4 py-4">
                    <div class="text-center">
                        <i class="bi bi-cloud-arrow-up fs-1 mb-3"></i>
                        <h3 class="fw-bold mb-2">Tipos de Almacenamiento</h3>
                        <p class="mb-0 opacity-75">Configura múltiples destinos donde se guardarán tus backups</p>
                    </div>
                </div>

                <!-- Cuerpo con pestañas -->
                <div class="card-body p-4">
                    <!-- Nav Tabs -->
                    <ul class="nav nav-pills nav-fill mb-4" id="storageTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <a class="nav-link" id="google-tab" role="tab" asp-area="" asp-controller="GoogleDriveStorage" asp-action="Index">
                                <i class="bi bi-google me-2"></i>Google Drive
                            </a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link active" id="onedrive-tab" role="tab" asp-area="" asp-controller="OneDriveStorage" asp-action="Index">
                                <i class="bi bi-microsoft me-2"></i>OneDrive
                            </a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link" id="blob-tab" role="tab" asp-area="" asp-controller="BlobStorage" asp-action="Index">
                                <i class="bi bi-cloud me-2"></i>Azure Blob
                            </a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link" id="ftp-tab" role="tab" asp-area="" asp-controller="FtpStorage" asp-action="Index">
                                <i class="bi bi-hdd-network me-2"></i>FTP
                            </a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link" id="local-tab" role="tab" asp-area="" asp-controller="LocalStorage" asp-action="Index">
                                <i class="bi bi-folder me-2"></i>Local
                            </a>
                        </li>
                    </ul>

                    <!-- Tab Content -->
                    <div class="tab-content" id="storageTabContent">
                        
                        <!-- OneDrive -->
                        <div class="tab-pane fade show active" id="onedrive" role="tabpanel">
                            <div class="text-center mb-4">
                                <i class="bi bi-microsoft text-primary" style="font-size: 3rem;"></i>
                                <h4 class="mt-3">Microsoft OneDrive</h4>
                                <p class="text-muted">Configura múltiples cuentas y carpetas de OneDrive</p>
                            </div>

                            <!-- Lista de configuraciones -->
                            <div class="mb-4">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="fw-semibold mb-0">
                                        <i class="bi bi-gear-fill me-2 text-primary"></i>Configuraciones Activas
                                    </h6>
                                    <span class="badge bg-primary rounded-pill">@Model.Count() configuradas</span>
                                </div>

                                @if (!Model.Any())
                                {
                                    <div class="alert alert-info" role="alert">
                                        <i class="bi bi-info-circle me-2"></i>
                                        No hay configuraciones de OneDrive registradas. Haz clic en "Agregar Nueva Configuración" para comenzar.
                                    </div>
                                }
                                else
                                {
                                    @foreach (var config in Model)
                                    {
                                        <!-- Configuración -->
                                        <div class="card mb-3 border-0 shadow-sm">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <div class="flex-grow-1">
                                                        <div class="d-flex align-items-center mb-2">
                                                            <div class="bg-primary bg-opacity-10 rounded-circle p-2 me-3">
                                                                <i class="bi bi-person-circle text-primary fs-5"></i>
                                                            </div>
                                                            <div>
                                                                <h6 class="mb-0 fw-semibold">
                                                                    <span class="text-primary">@config.ConfigurationName</span>
                                                                    <span class="text-muted fw-normal"> - @config.Email</span>
                                                                </h6>
                                                                @if (config.TokenExpiresAt.HasValue)
                                                                {
                                                                    var daysAgo = (DateTime.Now - config.TokenExpiresAt.Value).Days;
                                                                    <small class="text-muted">Conectado hace @Math.Abs(daysAgo) días</small>
                                                                }
                                                            </div>
                                                        </div>
                                                        <div class="ms-5 ps-2">
                                                            <div class="mb-1">
                                                                <i class="bi bi-folder me-2 text-muted"></i>
                                                                <span class="text-muted">Ruta:</span>
                                                                <code class="ms-1">@(string.IsNullOrEmpty(config.FolderPath) ? "/" : config.FolderPath)</code>
                                                            </div>
                                                            <span class="badge bg-success">
                                                                <i class="bi bi-check-circle me-1"></i>Activo
                                                            </span>
                                                        </div>
                                                    </div>
                                                    <div>
                                                        <button class="btn btn-sm btn-outline-primary rounded-pill me-2"
                                                                onclick="openEditModal(@config.Id)"
                                                                aria-label="Editar configuración">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-danger rounded-pill"
                                                                onclick="openDeleteModal(@config.Id, '@config.ConfigurationName', '@config.Email', '@(string.IsNullOrEmpty(config.FolderPath) ? "/" : config.FolderPath)')"
                                                                aria-label="Eliminar configuración">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>

                            <!-- Botón agregar nueva configuración -->
                            <div class="d-grid">
                                <button type="button" class="btn btn-outline-primary btn-lg rounded-pill" data-bs-toggle="modal" data-bs-target="#addOneDriveModal">
                                    <i class="bi bi-plus-circle me-2"></i>Agregar Nueva Configuración
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Información adicional -->
            <div class="alert alert-info rounded-4 mt-4 shadow-sm" role="alert">
                <div class="d-flex align-items-center">
                    <i class="bi bi-info-circle-fill fs-3 me-3"></i>
                    <div>
                        <h6 class="mb-1 fw-semibold">Múltiples destinos</h6>
                        <p class="mb-0">Puedes configurar múltiples destinos del mismo tipo. Los backups se copiarán a todos los destinos configurados como activos.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Agregar OneDrive -->
<div class="modal fade" id="addOneDriveModal" tabindex="-1" aria-labelledby="addOneDriveModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white border-0">
                <h5 class="modal-title" id="addOneDriveModalLabel">
                    <i class="bi bi-microsoft me-2"></i>Agregar Configuración de OneDrive
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4">
                <form id="addOneDriveForm">
                    <div class="mb-3">
                        <label for="oneDriveConfigName" class="form-label fw-semibold">
                            <i class="bi bi-tag me-2 text-primary"></i>Nombre de Configuración
                        </label>
                        <input type="text" class="form-control" id="oneDriveConfigName" placeholder="Ej: Backup Principal" required>
                        <div class="form-text">Dale un nombre descriptivo a esta configuración</div>
                    </div>
                    <div class="mb-3">
                        <label for="oneDriveEmail" class="form-label fw-semibold">
                            <i class="bi bi-envelope me-2 text-primary"></i>Correo de Microsoft
                        </label>
                        <div class="input-group">
                            <input type="email" class="form-control" id="oneDriveEmail" placeholder="usuario@outlook.com" required readonly>
                            <button class="btn btn-outline-primary" type="button" id="btnConnectOneDrive">
                                <i class="bi bi-microsoft me-1"></i>Conectar
                            </button>
                        </div>
                        <div class="form-text">Conéctate con tu cuenta de Microsoft para acceder a OneDrive</div>
                    </div>
                    <div class="mb-3">
                        <label for="oneDriveFolderPath" class="form-label fw-semibold">
                            <i class="bi bi-folder me-2 text-primary"></i>Ruta de Carpeta
                        </label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="oneDriveFolderPath" placeholder="/Backups/Empresa" required readonly>
                            <button class="btn btn-outline-secondary" type="button" id="btnExploreOneDrive" disabled>
                                <i class="bi bi-folder2-open me-1"></i>Explorar
                            </button>
                        </div>
                        <div class="form-text">Ruta donde se guardarán los backups en OneDrive</div>
                    </div>
                    <div class="alert alert-info rounded-3 mb-0" role="alert">
                        <i class="bi bi-info-circle me-2"></i>
                        <small>Se abrirá una ventana de autenticación de Microsoft para autorizar el acceso</small>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 bg-light">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-2"></i>Cancelar
                </button>
                <button type="submit" form="addOneDriveForm" class="btn btn-primary rounded-pill">
                    <i class="bi bi-microsoft me-2"></i>Conectar con OneDrive
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Editar OneDrive -->
<div class="modal fade" id="editOneDriveModal" tabindex="-1" aria-labelledby="editOneDriveModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-warning text-dark border-0">
                <h5 class="modal-title" id="editOneDriveModalLabel">
                    <i class="bi bi-pencil-square me-2"></i>Editar Configuración de OneDrive
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4">
                <form id="editOneDriveForm">
                    <input type="hidden" id="editOneDriveId">
                    <input type="hidden" id="editOneDriveItemId">
                    <div class="mb-3">
                        <label for="editOneDriveConfigName" class="form-label fw-semibold">
                            <i class="bi bi-tag me-2 text-warning"></i>Nombre de Configuración
                        </label>
                        <input type="text" class="form-control" id="editOneDriveConfigName" required>
                        <div class="form-text">Dale un nombre descriptivo a esta configuración</div>
                    </div>
                    <div class="mb-3">
                        <label for="editOneDriveEmail" class="form-label fw-semibold">
                            <i class="bi bi-envelope me-2 text-warning"></i>Correo de Microsoft
                        </label>
                        <div class="input-group">
                            <input type="email" class="form-control" id="editOneDriveEmail" readonly>
                            <button class="btn btn-outline-warning" type="button" id="btnEditConnectOneDrive">
                                <i class="bi bi-microsoft me-1"></i>Reconectar
                            </button>
                        </div>
                        <div class="form-text">Reconéctate si necesitas actualizar el acceso</div>
                    </div>
                    <div class="mb-3">
                        <label for="editOneDriveFolderPath" class="form-label fw-semibold">
                            <i class="bi bi-folder me-2 text-warning"></i>Ruta de Carpeta
                        </label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="editOneDriveFolderPath" required readonly>
                            <button class="btn btn-outline-secondary" type="button" id="btnExploreEditOneDrive">
                                <i class="bi bi-folder2-open me-1"></i>Explorar
                            </button>
                        </div>
                        <div class="form-text">Ruta donde se guardarán los backups en OneDrive</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 bg-light">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-2"></i>Cancelar
                </button>
                <button type="submit" form="editOneDriveForm" class="btn btn-warning rounded-pill">
                    <i class="bi bi-save me-2"></i>Guardar Cambios
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Eliminar OneDrive -->
<div class="modal fade" id="deleteOneDriveModal" tabindex="-1" aria-labelledby="deleteOneDriveModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-danger text-white border-0">
                <h5 class="modal-title" id="deleteOneDriveModalLabel">
                    <i class="bi bi-exclamation-triangle me-2"></i>Confirmar Eliminación
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4">
                <div class="text-center mb-4">
                    <div class="bg-danger bg-opacity-10 rounded-circle p-3 d-inline-flex mb-3">
                        <i class="bi bi-trash text-danger" style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="fw-semibold">¿Estás seguro de eliminar esta configuración?</h5>
                </div>
                <div class="bg-light rounded-3 p-3 mb-3">
                    <div class="mb-2">
                        <strong class="text-primary" id="deleteOneDriveConfigName"></strong>
                        <span class="text-muted"> - <span id="deleteOneDriveEmail"></span></span>
                    </div>
                    <div class="text-muted">
                        <small>
                            <i class="bi bi-folder me-2"></i>
                            Ruta: <code id="deleteOneDrivePath"></code>
                        </small>
                    </div>
                </div>
                <div class="alert alert-danger rounded-3 mb-0" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <strong>Advertencia:</strong> Esta acción no se puede deshacer. Los backups existentes en OneDrive no serán eliminados, solo se removerá la configuración de este sistema.
                </div>
            </div>
            <div class="modal-footer border-0 bg-light">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-2"></i>Cancelar
                </button>
                <button type="button" class="btn btn-danger rounded-pill" id="btnConfirmDeleteOneDrive">
                    <i class="bi bi-trash me-2"></i>Sí, Eliminar Configuración
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Explorador OneDrive -->
<div class="modal fade" id="oneDriveExplorerModal" tabindex="-1" aria-labelledby="oneDriveExplorerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white border-0">
                <h5 class="modal-title" id="oneDriveExplorerModalLabel">
                    <i class="bi bi-folder2-open me-2"></i>Explorador de OneDrive
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Breadcrumb / Ruta actual -->
                <div class="mb-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center flex-grow-1">
                            <button class="btn btn-sm btn-outline-secondary me-2" id="btnOneDriveBack" disabled>
                                <i class="bi bi-arrow-left"></i>
                            </button>
                            <div class="flex-grow-1">
                                <small class="text-muted">Ubicación actual:</small>
                                <div class="fw-semibold text-truncate" id="oneDriveCurrentPath">/Mi unidad</div>
                            </div>
                        </div>
                        <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#createOneDriveFolderModal">
                            <i class="bi bi-folder-plus me-1"></i>Nueva Carpeta
                        </button>
                    </div>
                </div>

                <!-- Lista de carpetas -->
                <div class="border rounded-3" style="min-height: 300px; max-height: 400px; overflow-y: auto;">
                    <!-- Loading -->
                    <div id="oneDriveFolderLoading" class="text-center py-5 d-none">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Cargando...</span>
                        </div>
                        <p class="mt-3 text-muted">Cargando carpetas de OneDrive...</p>
                    </div>

                    <!-- Error -->
                    <div id="oneDriveFolderError" class="alert alert-danger m-3 d-none" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <span id="oneDriveFolderErrorMessage"></span>
                    </div>

                    <!-- Lista de carpetas -->
                    <div id="oneDriveFolderList" class="list-group list-group-flush">
                        <!-- Las carpetas se cargarán aquí -->
                    </div>

                    <!-- Empty state -->
                    <div id="oneDriveFolderEmpty" class="text-center py-5 d-none">
                        <i class="bi bi-folder-x text-muted" style="font-size: 3rem;"></i>
                        <p class="mt-3 text-muted">No hay subcarpetas en este directorio</p>
                        <small class="text-muted">Puedes seleccionar esta ubicación para guardar tus backups</small>
                    </div>
                </div>

                <!-- Ruta seleccionada -->
                <div class="mt-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-check-circle me-2 text-success"></i>Ruta seleccionada:
                    </label>
                    <input type="text" class="form-control" id="oneDriveSelectedPath" value="/Mi unidad" readonly>
                </div>
            </div>
            <div class="modal-footer border-0 bg-light">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-2"></i>Cancelar
                </button>
                <button type="button" class="btn btn-primary rounded-pill" id="btnSelectOneDriveFolder">
                    <i class="bi bi-check-circle me-2"></i>Seleccionar Carpeta
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Crear Carpeta OneDrive -->
<div class="modal fade" id="createOneDriveFolderModal" tabindex="-1" aria-labelledby="createOneDriveFolderModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-success text-white border-0">
                <h5 class="modal-title" id="createOneDriveFolderModalLabel">
                    <i class="bi bi-folder-plus me-2"></i>Nueva Carpeta
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4">
                <form id="createOneDriveFolderForm">
                    <div class="mb-3">
                        <label for="newOneDriveFolderName" class="form-label fw-semibold">
                            <i class="bi bi-folder me-2 text-success"></i>Nombre de la carpeta
                        </label>
                        <input type="text" class="form-control" id="newOneDriveFolderName" placeholder="Nueva Carpeta" required>
                        <div class="form-text">Ingresa el nombre de la nueva carpeta</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 bg-light">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-2"></i>Cancelar
                </button>
                <button type="submit" form="createOneDriveFolderForm" class="btn btn-success rounded-pill" id="btnConfirmCreateOneDriveFolder">
                    <i class="bi bi-folder-plus me-2"></i>Crear Carpeta
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .nav-pills .nav-link {
        border-radius: 50rem;
        padding: 0.75rem 1.5rem;
        font-weight: 500;
        transition: all 0.3s ease;
    }

        .nav-pills .nav-link:hover {
            background-color: rgba(13, 110, 253, 0.1);
            transform: translateY(-2px);
        }

        .nav-pills .nav-link.active {
            background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
            box-shadow: 0 4px 6px rgba(13, 110, 253, 0.3);
        }

    .tab-pane {
        animation: fadeIn 0.3s ease-in;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .rounded-circle {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Estilos del explorador FTP */
    .ftp-folder-item {
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .ftp-folder-item:hover {
            background-color: rgba(13, 110, 253, 0.1);
            transform: translateX(5px);
        }

        .ftp-folder-item.selected {
            background-color: rgba(13, 110, 253, 0.15);
            border-left: 3px solid #0d6efd;
        }

    .breadcrumb-item.breadcrumb-link {
        cursor: pointer;
        color: #0d6efd;
    }

        .breadcrumb-item.breadcrumb-link:hover {
            text-decoration: underline;
        }

    /* Estilos del explorador Blob */
    .blob-container-item,
    .blob-folder-item {
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .blob-container-item:hover,
        .blob-folder-item:hover {
            background-color: rgba(13, 110, 253, 0.1);
            transform: translateX(5px);
        }

        .blob-container-item.selected,
        .blob-folder-item.selected {
            background-color: rgba(13, 110, 253, 0.15);
            border-left: 3px solid #0d6efd;
        }

    /* Estilos para modales de crear carpeta */
    #createFtpFolderModal,
    #createBlobFolderModal,
    #createDriveFolderModal {
        z-index: 1060 !important;
    }

        #createFtpFolderModal .modal-backdrop,
        #createBlobFolderModal .modal-backdrop,
        #createDriveFolderModal .modal-backdrop {
            z-index: 1059 !important;
        }

    /* Estilos del explorador Google Drive */
    .drive-folder-item {
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .drive-folder-item:hover {
            background-color: rgba(13, 110, 253, 0.1);
            transform: translateX(5px);
        }

        .drive-folder-item.selected {
            background-color: rgba(13, 110, 253, 0.15);
            border-left: 3px solid #0d6efd;
        }
</style>

<!-- Contenedor de toasts -->
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 2000;">
    <div id="successToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                <i class="bi bi-check-circle me-2"></i>
                <span id="successToastMessage"></span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
    <div id="errorToast" class="toast align-items-center text-white bg-danger border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                <i class="bi bi-exclamation-triangle me-2"></i>
                <span id="errorToastMessage"></span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
    <div id="warningToast" class="toast align-items-center text-white bg-warning border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                <i class="bi bi-info-circle me-2"></i>
                <span id="warningToastMessage"></span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<script>
    // Función helper para mostrar toasts
    function showToast(type, message) {
        const toastElement = document.getElementById(type + 'Toast');
        const messageElement = document.getElementById(type + 'ToastMessage');
        messageElement.textContent = message;

        const toast = new bootstrap.Toast(toastElement, {
            autohide: true,
            delay: 3000
        });
        toast.show();
    }

    // ========== ONEDRIVE AUTHENTICATION ==========

    // Variables globales para almacenar tokens de OneDrive
    let oneDriveAccessToken = null;
    let oneDriveRefreshToken = null;
    let oneDriveEmail = null;

    // Variables globales para OneDrive Explorer
    let oneDriveExplorerData = {
        accessToken: '',
        currentItemId: '',
        currentPath: '/Mi unidad',
        folderStack: [], // Stack para navegación: [{id, name, path}, ...]
        isEditMode: false
    };

    // Botón para conectar con OneDrive (modal agregar)
    document.getElementById('btnConnectOneDrive')?.addEventListener('click', function() {
        authenticateWithOneDrive();
    });

    // Botón para reconectar con OneDrive (modal editar)
    document.getElementById('btnEditConnectOneDrive')?.addEventListener('click', function() {
        // Guardar el ID de la configuración actual para actualizar tokens después
        currentOneDriveConfigId = parseInt(document.getElementById('editOneDriveId').value);
        authenticateWithOneDrive(true);
    });

    // Función para autenticar con OneDrive
    function authenticateWithOneDrive(isReconnect = false) {
        // Abrir ventana de autenticación de Microsoft
        const authWindow = window.open(
            '/OneDriveStorage/OneDriveAuth',
            'OneDriveAuth',
            'width=600,height=700,left=200,top=100'
        );

        // Escuchar mensaje de la ventana de autenticación
        window.addEventListener('message', function handleAuthMessage(event) {
            // Verificar que el mensaje viene de nuestro dominio
            if (event.origin !== window.location.origin) {
                return;
            }

            // Verificar que es el mensaje de autenticación de OneDrive
            if (!event.data || typeof event.data.success === 'undefined') {
                return;
            }

            // Remover el listener después de recibir el mensaje
            window.removeEventListener('message', handleAuthMessage);

            if (event.data.success) {
                oneDriveAccessToken = event.data.accessToken;
                oneDriveRefreshToken = event.data.refreshToken; // Guardar refresh token
                oneDriveEmail = event.data.email;

                // Actualizar también el oneDriveExplorerData para que funcione el explorador
                oneDriveExplorerData.accessToken = event.data.accessToken;

                if (isReconnect) {
                    // Actualizar el email en el modal de editar
                    document.getElementById('editOneDriveEmail').value = oneDriveEmail;
                    showToast('success', 'Reconexión exitosa con OneDrive: ' + oneDriveEmail);

                    // Habilitar el botón de explorar
                    document.getElementById('btnExploreEditOneDrive').disabled = false;

                    // Si hay un ID de configuración guardado, actualizar los tokens inmediatamente
                    if (currentOneDriveConfigId) {
                        saveOneDriveTokens(currentOneDriveConfigId, oneDriveAccessToken, oneDriveRefreshToken).then(() => {
                            showToast('success', 'Tokens actualizados correctamente.');
                        });
                    }
                } else {
                    // Actualizar el email en el modal de agregar
                    document.getElementById('oneDriveEmail').value = oneDriveEmail;
                    showToast('success', 'Conexión exitosa con OneDrive: ' + oneDriveEmail);

                    // Habilitar el botón de explorar
                    document.getElementById('btnExploreOneDrive').disabled = false;
                }
            } else {
                showToast('error', 'Error de autenticación: ' + (event.data.message || 'Error desconocido'));
            }
        });

        // Verificar si la ventana fue cerrada sin completar la autenticación
        const checkWindowClosed = setInterval(function() {
            if (authWindow.closed) {
                clearInterval(checkWindowClosed);
                if (!oneDriveAccessToken) {
                    showToast('warning', 'Autenticación cancelada');
                }
            }
        }, 500);
    }

    // Botón para explorar OneDrive (modo agregar)
    document.getElementById('btnExploreOneDrive')?.addEventListener('click', function() {
        openOneDriveExplorer(false);
    });

    // Botón para explorar OneDrive (modo editar)
    document.getElementById('btnExploreEditOneDrive')?.addEventListener('click', function() {
        openOneDriveExplorer(true);
    });

    // Función para abrir el explorador de OneDrive
    function openOneDriveExplorer(isEditMode) {
        if (!oneDriveExplorerData.accessToken) {
            showToast('warning', 'Por favor, conéctate con OneDrive primero.');
            return;
        }

        oneDriveExplorerData.isEditMode = isEditMode;
        oneDriveExplorerData.currentItemId = '';
        oneDriveExplorerData.currentPath = '/Mi unidad';
        oneDriveExplorerData.folderStack = [];

        // Resetear UI
        document.getElementById('oneDriveSelectedPath').value = '/Mi unidad';

        // Abrir modal
        const explorerModal = new bootstrap.Modal(document.getElementById('oneDriveExplorerModal'));
        explorerModal.show();

        // Cargar carpetas raíz
        loadOneDriveFolders('');
    }

    // Función para cargar carpetas de OneDrive
    async function loadOneDriveFolders(itemId) {
        const loading = document.getElementById('oneDriveFolderLoading');
        const error = document.getElementById('oneDriveFolderError');
        const list = document.getElementById('oneDriveFolderList');
        const empty = document.getElementById('oneDriveFolderEmpty');

        // Mostrar loading
        loading.classList.remove('d-none');
        error.classList.add('d-none');
        list.innerHTML = '';
        empty.classList.add('d-none');

        try {
            const response = await fetch('/OneDriveStorage/ListOneDriveFolders', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    accessToken: oneDriveExplorerData.accessToken,
                    itemId: itemId || ''
                })
            });

            const data = await response.json();

            loading.classList.add('d-none');

            if (data.success) {
                if (data.folders.length === 0) {
                    empty.classList.remove('d-none');
                } else {
                    data.folders.forEach(folder => {
                        const item = createOneDriveFolderItem(folder);
                        list.appendChild(item);
                    });
                }
            } else {
                error.classList.remove('d-none');
                document.getElementById('oneDriveFolderErrorMessage').textContent = data.message;
            }
        } catch (ex) {
            loading.classList.add('d-none');
            error.classList.remove('d-none');
            document.getElementById('oneDriveFolderErrorMessage').textContent = 'Error de conexión: ' + ex.message;
        }
    }

    // Función para crear un elemento de carpeta OneDrive
    function createOneDriveFolderItem(folder) {
        const item = document.createElement('a');
        item.href = '#';
        item.className = 'list-group-item list-group-item-action onedrive-folder-item';

        item.innerHTML = `
            <div class="d-flex align-items-center">
                <i class="bi bi-folder me-3 text-primary fs-5"></i>
                <div class="flex-grow-1">
                    <div class="fw-semibold">${folder.name}</div>
                    <small class="text-muted">Modificado: ${new Date(folder.lastModifiedDateTime).toLocaleDateString()}</small>
                </div>
                <i class="bi bi-chevron-right text-muted"></i>
            </div>
        `;

        // Click simple: navegar dentro de la carpeta
        item.addEventListener('click', function(e) {
            e.preventDefault();
            navigateToOneDriveFolder(folder.id, folder.name);
        });

        return item;
    }

    // Función para navegar a una carpeta de OneDrive
    function navigateToOneDriveFolder(itemId, folderName) {
        // Guardar carpeta actual en el stack
        oneDriveExplorerData.folderStack.push({
            id: oneDriveExplorerData.currentItemId,
            name: oneDriveExplorerData.currentPath.split('/').pop() || 'Mi unidad',
            path: oneDriveExplorerData.currentPath
        });

        // Actualizar datos actuales
        oneDriveExplorerData.currentItemId = itemId;
        oneDriveExplorerData.currentPath = oneDriveExplorerData.currentPath + '/' + folderName;

        // Actualizar UI
        document.getElementById('oneDriveCurrentPath').textContent = oneDriveExplorerData.currentPath;
        document.getElementById('oneDriveSelectedPath').value = oneDriveExplorerData.currentPath;
        document.getElementById('btnOneDriveBack').disabled = false;

        // Cargar subcarpetas
        loadOneDriveFolders(itemId);
    }

    // Botón "Atrás" en el explorador
    document.getElementById('btnOneDriveBack')?.addEventListener('click', function() {
        if (oneDriveExplorerData.folderStack.length === 0) return;

        // Obtener carpeta anterior del stack
        const previous = oneDriveExplorerData.folderStack.pop();

        // Actualizar datos actuales
        oneDriveExplorerData.currentItemId = previous.id;
        oneDriveExplorerData.currentPath = previous.path;

        // Actualizar UI
        document.getElementById('oneDriveCurrentPath').textContent = oneDriveExplorerData.currentPath;
        document.getElementById('oneDriveSelectedPath').value = oneDriveExplorerData.currentPath;

        // Deshabilitar botón si llegamos a la raíz
        if (oneDriveExplorerData.folderStack.length === 0) {
            this.disabled = true;
        }

        // Cargar carpetas del nivel anterior
        loadOneDriveFolders(previous.id);
    });

    // Botón "Seleccionar Carpeta"
    document.getElementById('btnSelectOneDriveFolder')?.addEventListener('click', function() {
        const selectedPath = document.getElementById('oneDriveSelectedPath').value;

        if (oneDriveExplorerData.isEditMode) {
            document.getElementById('editOneDriveFolderPath').value = selectedPath;
        } else {
            document.getElementById('oneDriveFolderPath').value = selectedPath;
        }

        // Cerrar modal
        bootstrap.Modal.getInstance(document.getElementById('oneDriveExplorerModal')).hide();
        showToast('success', 'Ruta seleccionada: ' + selectedPath);
    });

    // Formulario crear carpeta OneDrive
    document.getElementById('createOneDriveFolderForm')?.addEventListener('submit', async function(e) {
        e.preventDefault();

        const folderName = document.getElementById('newOneDriveFolderName').value.trim();
        if (!folderName) {
            showToast('error', 'El nombre de la carpeta no puede estar vacío');
            return;
        }

        const btn = document.getElementById('btnConfirmCreateOneDriveFolder');
        const originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Creando...';

        try {
            const response = await fetch('/OneDriveStorage/CreateOneDriveFolder', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    accessToken: oneDriveExplorerData.accessToken,
                    parentId: oneDriveExplorerData.currentItemId || '',
                    folderName: folderName
                })
            });

            const data = await response.json();

            if (data.success) {
                showToast('success', 'Carpeta creada exitosamente');

                // Cerrar modal de crear carpeta
                bootstrap.Modal.getInstance(document.getElementById('createOneDriveFolderModal')).hide();

                // Limpiar campo
                document.getElementById('newOneDriveFolderName').value = '';

                // Recargar lista de carpetas
                loadOneDriveFolders(oneDriveExplorerData.currentItemId);
            } else {
                showToast('error', 'Error al crear carpeta: ' + data.message);
            }
        } catch (error) {
            showToast('error', 'Error de conexión: ' + error.message);
        } finally {
            btn.disabled = false;
            btn.innerHTML = originalHtml;
        }
    });

    // Permitir crear carpeta OneDrive con Enter en el input
    document.getElementById('newOneDriveFolderName')?.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            document.getElementById('btnConfirmCreateOneDriveFolder').click();
        }
    });

    // ========== CRUD OPERATIONS ==========

    // Variables globales para CRUD
    let deleteOneDriveId = null;
    let currentOneDriveConfigId = null; // Para guardar tokens después de autenticar

    // Agregar nueva configuración de OneDrive
    document.getElementById('addOneDriveForm')?.addEventListener('submit', async function(e) {
        e.preventDefault();

        const configName = document.getElementById('oneDriveConfigName').value.trim();
        const email = document.getElementById('oneDriveEmail').value.trim();
        const folderPath = document.getElementById('oneDriveFolderPath').value.trim();

        if (!configName || !email || !folderPath) {
            showToast('warning', 'Por favor, completa todos los campos. Debes conectarte con OneDrive y seleccionar una carpeta.');
            return;
        }

        try {
            const response = await fetch('/OneDriveStorage/Create', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                },
                body: JSON.stringify({
                    ConfigurationName: configName,
                    Email: email,
                    ItemId: oneDriveExplorerData.currentItemId || '',
                    FolderPath: folderPath
                })
            });

            const data = await response.json();

            if (data.success) {
                // Guardar tokens si hay acceso token
                if (oneDriveAccessToken && data.id) {
                    await saveOneDriveTokens(data.id, oneDriveAccessToken, oneDriveRefreshToken);
                }

                showToast('success', data.message || 'Configuración creada exitosamente.');

                // Cerrar modal
                const addModal = bootstrap.Modal.getInstance(document.getElementById('addOneDriveModal'));
                addModal.hide();

                // Limpiar formulario
                document.getElementById('addOneDriveForm').reset();
                document.getElementById('btnExploreOneDrive').disabled = true;
                oneDriveAccessToken = null;
                oneDriveRefreshToken = null;
                oneDriveEmail = null;

                // Recargar página
                setTimeout(() => location.reload(), 1000);
            } else {
                showToast('error', data.message || 'Error al crear la configuración.');
            }
        } catch (error) {
            showToast('error', 'Error de conexión: ' + error.message);
        }
    });

    // Abrir modal de edición
    async function openEditModal(id) {
        try {
            const response = await fetch(`/OneDriveStorage/GetById?id=${id}`);
            const data = await response.json();

            if (data.success) {
                const config = data.data;

                // Cargar datos en el formulario
                document.getElementById('editOneDriveId').value = config.id;
                document.getElementById('editOneDriveConfigName').value = config.configurationName;
                document.getElementById('editOneDriveEmail').value = config.email;
                document.getElementById('editOneDriveItemId').value = config.itemId || '';
                document.getElementById('editOneDriveFolderPath').value = config.folderPath || '/Mi unidad';

                // Si hay token guardado, usarlo para el explorador
                if (data.accessToken && data.hasValidToken) {
                    oneDriveExplorerData.accessToken = data.accessToken;
                    oneDriveAccessToken = data.accessToken;
                    document.getElementById('btnExploreEditOneDrive').disabled = false;
                } else {
                    document.getElementById('btnExploreEditOneDrive').disabled = true;
                }

                // Abrir modal
                const editModal = new bootstrap.Modal(document.getElementById('editOneDriveModal'));
                editModal.show();
            } else {
                showToast('error', 'Error al cargar la configuración.');
            }
        } catch (error) {
            showToast('error', 'Error de conexión: ' + error.message);
        }
    }

    // Actualizar configuración de OneDrive
    document.getElementById('editOneDriveForm')?.addEventListener('submit', async function(e) {
        e.preventDefault();

        const id = document.getElementById('editOneDriveId').value;
        const configName = document.getElementById('editOneDriveConfigName').value.trim();
        const email = document.getElementById('editOneDriveEmail').value.trim();
        const folderPath = document.getElementById('editOneDriveFolderPath').value.trim();

        if (!configName || !email || !folderPath) {
            showToast('warning', 'Por favor, completa todos los campos requeridos.');
            return;
        }

        try {
            const response = await fetch('/OneDriveStorage/Edit', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                },
                body: JSON.stringify({
                    Id: parseInt(id),
                    ConfigurationName: configName,
                    Email: email,
                    ItemId: oneDriveExplorerData.currentItemId || document.getElementById('editOneDriveItemId').value,
                    FolderPath: folderPath
                })
            });

            const data = await response.json();

            if (data.success) {
                // Guardar tokens si se reconectó
                if (oneDriveAccessToken) {
                    await saveOneDriveTokens(parseInt(id), oneDriveAccessToken, oneDriveRefreshToken);
                }

                showToast('success', data.message || 'Configuración actualizada exitosamente.');

                // Cerrar modal
                const editModal = bootstrap.Modal.getInstance(document.getElementById('editOneDriveModal'));
                editModal.hide();

                // Recargar página
                setTimeout(() => location.reload(), 1000);
            } else {
                showToast('error', data.message || 'Error al actualizar la configuración.');
            }
        } catch (error) {
            showToast('error', 'Error de conexión: ' + error.message);
        }
    });

    // Abrir modal de eliminación
    function openDeleteModal(id, name, email, path) {
        deleteOneDriveId = id;
        document.getElementById('deleteOneDriveConfigName').textContent = name;
        document.getElementById('deleteOneDriveEmail').textContent = email;
        document.getElementById('deleteOneDrivePath').textContent = path;

        const deleteModal = new bootstrap.Modal(document.getElementById('deleteOneDriveModal'));
        deleteModal.show();
    }

    // Confirmar eliminación
    document.getElementById('btnConfirmDeleteOneDrive')?.addEventListener('click', async function() {
        if (!deleteOneDriveId) {
            showToast('error', 'ID de configuración no válido.');
            return;
        }

        try {
            const response = await fetch(`/OneDriveStorage/Delete?id=${deleteOneDriveId}`, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                }
            });

            const data = await response.json();

            if (data.success) {
                showToast('success', data.message || 'Configuración eliminada exitosamente.');

                // Cerrar modal
                const deleteModal = bootstrap.Modal.getInstance(document.getElementById('deleteOneDriveModal'));
                deleteModal.hide();

                // Recargar página
                setTimeout(() => location.reload(), 1000);
            } else {
                showToast('error', data.message || 'Error al eliminar la configuración.');
            }
        } catch (error) {
            showToast('error', 'Error de conexión: ' + error.message);
        }
    });

    // Función auxiliar para guardar tokens de OneDrive
    async function saveOneDriveTokens(configId, accessToken, refreshToken) {
        try {
            const response = await fetch('/OneDriveStorage/SaveTokens', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                },
                body: JSON.stringify({
                    Id: configId,
                    AccessToken: accessToken,
                    RefreshToken: refreshToken
                })
            });

            const data = await response.json();
            if (!data.success) {
                console.error('Error al guardar tokens:', data.message);
            }
        } catch (error) {
            console.error('Error al guardar tokens:', error);
        }
    }

</script>
