
@model BackupPro.ViewModels.LoginViewModel
<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center py-5">
    <div class="row w-100 justify-content-center">
        <div class="col-11 col-sm-10 col-md-8 col-lg-5 col-xl-4">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <!-- Header con gradiente -->
                <div class="card-header text-center py-4 border-0 login-header">
                    <div class="mb-3">
                        <i class="bi bi-shield-lock-fill text-white" style="font-size: 3.5rem;"></i>
                    </div>
                    <h2 class="text-white fw-bold mb-1">Iniciar sesión</h2>
                    <p class="text-white-50 mb-0">Accede a BackupPro</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    <!-- Mensaje de éxito -->
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <!-- Mensaje de error -->
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <!-- Error de login -->
                    @if (TempData["LoginError"] != null)
                    {
                        <div class="alert alert-warning alert-dismissible fade show rounded-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            @TempData["LoginError"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <!-- Errores de validación -->
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <!-- Formulario -->
                    <form asp-action="Login" method="post" autocomplete="off">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label asp-for="Email" class="form-label fw-semibold">
                                <i class="bi bi-person-fill me-2 text-primary"></i>Usuario o correo
                            </label>
                            <input asp-for="Email" class="form-control form-control-lg rounded-3" placeholder="usuario o correo" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password" class="form-label fw-semibold">
                                <i class="bi bi-lock-fill me-2 text-primary"></i>Contraseña
                            </label>
                            <div class="input-group input-group-lg">
                                <input asp-for="Password" type="password" id="passwordInput" class="form-control rounded-start-3 border-end-0" placeholder="••••••••" />
                                <span class="input-group-text bg-white border-start-0 rounded-end-3" style="cursor: pointer;" id="togglePassword">
                                    <i class="bi bi-eye-fill" id="toggleIcon"></i>
                                </span>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2 mb-3">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill shadow-sm">
                                <i class="bi bi-box-arrow-in-right me-2"></i> Ingresar
                            </button>
                        </div>
                    </form>

                    <!-- Separador -->
                    <div class="position-relative mb-3">
                        <hr class="text-muted">
                        <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted small">
                            O continuar con
                        </span>
                    </div>

                    <!-- Botones de autenticación externa -->
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <form asp-controller="Account" asp-action="ExternalLogin" method="post" id="googleForm">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="provider" value="Google" />
                                <button type="submit" class="btn btn-outline-secondary w-100 rounded-3" onclick="console.log('Botón Google clickeado')">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-google me-2" viewBox="0 0 16 16">
                                        <path d="M15.545 6.558a9.42 9.42 0 0 1 .139 1.626c0 2.434-.87 4.492-2.384 5.885h.002C11.978 15.292 10.158 16 8 16A8 8 0 1 1 8 0a7.689 7.689 0 0 1 5.352 2.082l-2.284 2.284A4.347 4.347 0 0 0 8 3.166c-2.087 0-3.86 1.408-4.492 3.304a4.792 4.792 0 0 0 0 3.063h.003c.635 1.893 2.405 3.301 4.492 3.301 1.078 0 2.004-.276 2.722-.764h-.003a3.702 3.702 0 0 0 1.599-2.431H8v-3.08h7.545z"/>
                                    </svg>
                                    Google
                                </button>
                            </form>
                        </div>
                        <div class="col-6">
                            <form asp-controller="Account" asp-action="ExternalLogin" method="post" id="microsoftForm">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="provider" value="Microsoft" />
                                <button type="submit" class="btn btn-outline-secondary w-100 rounded-3" onclick="console.log('Botón Microsoft clickeado')">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-microsoft me-2" viewBox="0 0 16 16">
                                        <path d="M7.462 0H0v7.19h7.462zM16 0H8.538v7.19H16zM7.462 8.211H0V16h7.462zm8.538 0H8.538V16H16z"/>
                                    </svg>
                                    Microsoft
                                </button>
                            </form>
                        </div>
                    </div>

                    <!-- Olvidaste tu contraseña -->
                    <div class="text-center mt-3">
                        <button id="forgotPasswordBtn" class="btn btn-link text-decoration-none text-muted" disabled>
                            <i class="bi bi-question-circle me-1"></i>
                            ¿Olvidaste tu contraseña?
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const emailInput = document.getElementById("Email");
        const forgotBtn = document.getElementById("forgotPasswordBtn");
        const passwordInput = document.getElementById("passwordInput");
        const togglePassword = document.getElementById("togglePassword");
        const toggleIcon = document.getElementById("toggleIcon");

        // Mostrar/Ocultar contraseña
        togglePassword.addEventListener("click", () => {
            const type = passwordInput.getAttribute("type") === "password" ? "text" : "password";
            passwordInput.setAttribute("type", type);

            // Cambiar icono
            if (type === "text") {
                toggleIcon.classList.remove("bi-eye-fill");
                toggleIcon.classList.add("bi-eye-slash-fill");
            } else {
                toggleIcon.classList.remove("bi-eye-slash-fill");
                toggleIcon.classList.add("bi-eye-fill");
            }
        });

        // Habilitar el botón solo si el email es válido
        emailInput.addEventListener("input", () => {
            if (emailInput.validity.valid && emailInput.value.trim() !== "") {
                forgotBtn.disabled = false;
            } else {
                forgotBtn.disabled = true;
            }
        });

        // Acción al hacer click en "¿Olvidaste tu contraseña?": envía un POST con token
        // antifalsificación (ya no es una navegación GET, para evitar CSRF)
        forgotBtn.addEventListener("click", () => {
            if (!emailInput.validity.valid) {
                return;
            }

            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/Home/ForgotPassword';
            form.style.display = 'none';

            const tokenField = document.createElement('input');
            tokenField.type = 'hidden';
            tokenField.name = '__RequestVerificationToken';
            tokenField.value = tokenInput ? tokenInput.value : '';
            form.appendChild(tokenField);

            const emailField = document.createElement('input');
            emailField.type = 'hidden';
            emailField.name = 'email';
            emailField.value = emailInput.value;
            form.appendChild(emailField);

            document.body.appendChild(form);
            form.submit();
        });
    </script>
}
