@model BackupPro.ViewModels.RestoreConfirmViewModel
@{
    ViewData["Title"] = "Confirmar Restauración";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-danger text-white border-0 rounded-top-4 py-4">
                    <div class="text-center">
                        <i class="bi bi-exclamation-triangle-fill fs-1 mb-3"></i>
                        <h3 class="fw-bold mb-2">Confirmar Restauración</h3>
                        <p class="mb-0 opacity-75">Esta acción reemplaza los datos actuales</p>
                    </div>
                </div>

                <div class="card-body p-4">
                    <div class="alert alert-danger rounded-3 mb-4" role="alert">
                        <i class="bi bi-exclamation-octagon-fill me-2"></i>
                        Vas a restaurar <strong>@Model.DatabaseName</strong> (@Model.DatabaseType) con el backup del
                        <strong>@Model.BackupDate.ToString("dd/MM/yyyy hh:mm:ss tt")</strong> (@Model.StorageType).
                        <strong>Todos los datos actuales de esa base de datos se reemplazarán por los del backup y no
                        se pueden recuperar después.</strong> Esta operación no se puede deshacer.
                    </div>

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                    <form asp-action="Confirm" method="post">
                        <input type="hidden" asp-for="BackupHistoryId" />

                        <div class="mb-3">
                            <label asp-for="ConfirmDatabaseName" class="form-label fw-semibold">
                                <i class="bi bi-database-fill me-2 text-danger"></i>
                                Escribe <code>@Model.DatabaseName</code> para confirmar
                            </label>
                            <input asp-for="ConfirmDatabaseName" class="form-control form-control-lg rounded-3" autocomplete="off" placeholder="@Model.DatabaseName" />
                            <span asp-validation-for="ConfirmDatabaseName" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="CurrentPassword" class="form-label fw-semibold">
                                <i class="bi bi-lock-fill me-2 text-danger"></i>Tu contraseña actual
                            </label>
                            <input asp-for="CurrentPassword" type="password" class="form-control form-control-lg rounded-3" autocomplete="current-password" />
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger btn-lg rounded-pill shadow-sm">
                                <i class="bi bi-arrow-counterclockwise me-2"></i>Restaurar y sobrescribir
                            </button>
                            <a asp-controller="BackupHistory" asp-action="Index" class="btn btn-outline-secondary rounded-pill">
                                Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
