@model IEnumerable<BackupPro.Models.RestoreHistory>
@{
    ViewData["Title"] = "Historial de Restauraciones";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold mb-0">
                <i class="bi bi-arrow-counterclockwise text-danger me-2"></i>Historial de Restauraciones
            </h2>
            <p class="text-muted mb-0">
                Auditoría de cada intento de restauración (exitoso o no). Estos registros no se borran
                automáticamente.
            </p>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="fw-semibold">Base de Datos</th>
                            <th class="fw-semibold">Fecha</th>
                            <th class="fw-semibold">Estado</th>
                            <th class="fw-semibold">Restaurado por</th>
                            <th class="fw-semibold">Mensaje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    Todavía no se restauró ningún backup.
                                </td>
                            </tr>
                        }
                        @foreach (var restore in Model)
                        {
                            <tr>
                                <td>
                                    <i class="bi bi-database-fill text-primary me-2"></i>
                                    <strong>@restore.DatabaseName</strong>
                                </td>
                                <td>
                                    <small class="text-muted">@restore.Date.ToString("dd/MM/yyyy hh:mm:ss tt")</small>
                                </td>
                                <td>
                                    @if (restore.Status == "Exitoso")
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Exitoso</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Error</span>
                                    }
                                </td>
                                <td>@(restore.RestoredBy ?? "-")</td>
                                <td>
                                    <small class="text-muted text-truncate d-inline-block" style="max-width: 350px;" title="@restore.Message">
                                        @restore.Message
                                    </small>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
