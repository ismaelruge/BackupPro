@model IEnumerable<BackupPro.Models.BackupHistory>
@{
    ViewData["Title"] = "Historial de Backups";
    var totalBackups = ViewBag.TotalBackups ?? 0;
    var successfulBackups = ViewBag.SuccessfulBackups ?? 0;
    var failedBackups = ViewBag.FailedBackups ?? 0;
    var successRate = totalBackups > 0 ? (successfulBackups * 100.0 / totalBackups) : 0;
}

<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="fw-bold mb-0">
                        <i class="bi bi-clock-history text-primary me-2"></i>Historial de Backups
                    </h2>
                    <p class="text-muted mb-0">Registro completo de todos los backups realizados</p>
                </div>
                <div>
                    <button type="button" class="btn btn-outline-danger" onclick="confirmClearAll()">
                        <i class="bi bi-trash me-2"></i>Limpiar Historial
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Estadísticas -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="bg-primary bg-opacity-10 rounded-circle p-3">
                                <i class="bi bi-database text-primary fs-3"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="text-muted mb-1">Total Backups</h6>
                            <h3 class="mb-0 fw-bold">@totalBackups</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="bg-success bg-opacity-10 rounded-circle p-3">
                                <i class="bi bi-check-circle text-success fs-3"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="text-muted mb-1">Exitosos</h6>
                            <h3 class="mb-0 fw-bold text-success">@successfulBackups</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="bg-danger bg-opacity-10 rounded-circle p-3">
                                <i class="bi bi-x-circle text-danger fs-3"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="text-muted mb-1">Fallidos</h6>
                            <h3 class="mb-0 fw-bold text-danger">@failedBackups</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="bg-info bg-opacity-10 rounded-circle p-3">
                                <i class="bi bi-graph-up text-info fs-3"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="text-muted mb-1">Tasa de Éxito</h6>
                            <h3 class="mb-0 fw-bold text-info">@successRate.ToString("F1")%</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtros y Búsqueda -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-controller="BackupHistory" asp-action="Index" id="filterForm">
                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-funnel me-2"></i>Filtrar por Estado
                        </label>
                        <select name="status" class="form-select" onchange="document.getElementById('filterForm').submit()">
                            <option value="">Todos</option>
                            @if (ViewBag.Status == "Exitoso")
                            {
                                <option value="Exitoso" selected>Exitoso</option>
                            }
                            else
                            {
                                <option value="Exitoso">Exitoso</option>
                            }
                            @if (ViewBag.Status == "Error")
                            {
                                <option value="Error" selected>Error</option>
                            }
                            else
                            {
                                <option value="Error">Error</option>
                            }
                        </select>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-search me-2"></i>Buscar Base de Datos
                        </label>
                        <div class="input-group">
                            <input type="text" name="search" class="form-control"
                                   placeholder="Nombre de base de datos..."
                                   value="@ViewBag.Search">
                            <button class="btn btn-primary" type="submit">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </div>

                    <div class="col-12 col-md-2 d-flex align-items-end">
                        <a href="@Url.Action("Index", "BackupHistory")" class="btn btn-outline-secondary w-100">
                            <i class="bi bi-arrow-counterclockwise me-2"></i>Limpiar
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla de Historiales -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-semibold">
                    <i class="bi bi-list-ul me-2 text-primary"></i>Registros de Backup
                </h5>
                <span class="badge bg-primary">@ViewBag.TotalRecords registros</span>
            </div>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox text-muted" style="font-size: 4rem;"></i>
                    <h4 class="text-muted mt-3">No hay registros de backups</h4>
                    <p class="text-muted">Los historiales de backups aparecerán aquí</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="fw-semibold">Base de Datos</th>
                                <th class="fw-semibold">Fecha</th>
                                <th class="fw-semibold">Estado</th>
                                <th class="fw-semibold">Ruta</th>
                                <th class="fw-semibold text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var history in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-database-fill text-primary me-2"></i>
                                            <strong>@history.DatabaseName</strong>
                                        </div>
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            <i class="bi bi-calendar me-1"></i>
                                            @history.Date.ToString("dd/MM/yyyy")
                                        </small>
                                        <br />
                                        <small class="text-muted">
                                            <i class="bi bi-clock me-1"></i>
                                            @history.Date.ToString("hh:mm:ss tt")
                                        </small>
                                    </td>
                                    <td>
                                        @if (history.Status == "Exitoso")
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle me-1"></i>Exitoso
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                <i class="bi bi-x-circle me-1"></i>Error
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <small class="text-muted text-truncate d-inline-block" style="max-width: 300px;" title="@history.BackupPath">
                                            <i class="bi bi-folder me-1"></i>@history.BackupPath
                                        </small>
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-primary me-1"
                                                onclick="showDetails(@history.Id)"
                                                title="Ver detalles">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger"
                                                onclick="confirmDelete(@history.Id)"
                                                title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Paginación -->
                @if (ViewBag.TotalPages > 1)
                {
                    <div class="card-footer bg-white border-top">
                        <nav aria-label="Page navigation">
                            <ul class="pagination justify-content-center mb-0">
                                @if (ViewBag.CurrentPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1, status = ViewBag.Status, search = ViewBag.Search })">
                                            <i class="bi bi-chevron-left"></i>
                                        </a>
                                    </li>
                                }

                                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                                {
                                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("Index", new { page = i, status = ViewBag.Status, search = ViewBag.Search })">
                                            @i
                                        </a>
                                    </li>
                                }

                                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1, status = ViewBag.Status, search = ViewBag.Search })">
                                            <i class="bi bi-chevron-right"></i>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- Modal Detalles -->
<div class="modal fade" id="detailsModal" tabindex="-1" aria-labelledby="detailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white border-0">
                <h5 class="modal-title" id="detailsModalLabel">
                    <i class="bi bi-info-circle me-2"></i>Detalles del Backup
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label fw-semibold text-muted">Base de Datos</label>
                        <div class="alert alert-light mb-0">
                            <i class="bi bi-database me-2"></i>
                            <span id="detailDatabaseName"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-muted">Fecha y Hora</label>
                        <div class="alert alert-light mb-0">
                            <i class="bi bi-calendar-event me-2"></i>
                            <span id="detailDate"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-muted">Estado</label>
                        <div class="alert alert-light mb-0" id="detailStatusContainer">
                            <span id="detailStatus"></span>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold text-muted">Ruta del Backup</label>
                        <div class="alert alert-light mb-0">
                            <i class="bi bi-folder me-2"></i>
                            <code id="detailBackupPath"></code>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold text-muted">Mensaje</label>
                        <div class="alert alert-info mb-0">
                            <i class="bi bi-chat-left-text me-2"></i>
                            <span id="detailMessage"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-2"></i>Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Confirmar Eliminar -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-danger text-white border-0">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="bi bi-exclamation-triangle me-2"></i>Confirmar Eliminación
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <div class="mb-3">
                    <i class="bi bi-trash text-danger" style="font-size: 3rem;"></i>
                </div>
                <h5>¿Estás seguro de eliminar este registro?</h5>
                <p class="text-muted">Esta acción no se puede deshacer.</p>
            </div>
            <div class="modal-footer border-0 bg-light">
                <input type="hidden" id="deleteHistoryId">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-2"></i>Cancelar
                </button>
                <button type="button" class="btn btn-danger" onclick="deleteHistory()">
                    <i class="bi bi-trash me-2"></i>Sí, Eliminar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Confirmar Limpiar Todo -->
<div class="modal fade" id="clearAllModal" tabindex="-1" aria-labelledby="clearAllModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-danger text-white border-0">
                <h5 class="modal-title" id="clearAllModalLabel">
                    <i class="bi bi-exclamation-triangle me-2"></i>Confirmar Limpieza Total
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <div class="mb-3">
                    <i class="bi bi-trash text-danger" style="font-size: 3rem;"></i>
                </div>
                <h5>¿Estás seguro de limpiar todo el historial?</h5>
                <p class="text-muted">Se eliminarán <strong>TODOS</strong> los registros de backup. Esta acción no se puede deshacer.</p>
            </div>
            <div class="modal-footer border-0 bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-2"></i>Cancelar
                </button>
                <button type="button" class="btn btn-danger" onclick="clearAll()">
                    <i class="bi bi-trash me-2"></i>Sí, Limpiar Todo
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Toast Container -->
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 2000;">
    <div id="successToast" class="toast align-items-center text-white bg-success border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body">
                <i class="bi bi-check-circle me-2"></i>
                <span id="successMessage"></span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
    <div id="errorToast" class="toast align-items-center text-white bg-danger border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body">
                <i class="bi bi-exclamation-triangle me-2"></i>
                <span id="errorMessage"></span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

<script>
    // Mostrar Toast
    function showToast(type, message) {
        const toastElement = document.getElementById(type + 'Toast');
        const messageElement = document.getElementById(type + 'Message');
        messageElement.textContent = message;

        const toast = new bootstrap.Toast(toastElement, {
            autohide: true,
            delay: 3000
        });
        toast.show();
    }

    // Mostrar detalles
    async function showDetails(id) {
        try {
            const response = await fetch('/BackupHistory/GetDetails?id=' + id);
            const result = await response.json();

            if (result.success) {
                document.getElementById('detailDatabaseName').textContent = result.data.databaseName;
                document.getElementById('detailDate').textContent = result.data.date;
                document.getElementById('detailBackupPath').textContent = result.data.backupPath;
                document.getElementById('detailMessage').textContent = result.data.message;

                const statusContainer = document.getElementById('detailStatusContainer');
                const statusSpan = document.getElementById('detailStatus');

                if (result.data.status === 'Exitoso') {
                    statusSpan.innerHTML = '<span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Exitoso</span>';
                } else {
                    statusSpan.innerHTML = '<span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Error</span>';
                }

                const modal = new bootstrap.Modal(document.getElementById('detailsModal'));
                modal.show();
            } else {
                showToast('error', result.message);
            }
        } catch (error) {
            showToast('error', 'Error al cargar los detalles: ' + error.message);
        }
    }

    // Confirmar eliminación
    function confirmDelete(id) {
        document.getElementById('deleteHistoryId').value = id;
        const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
        modal.show();
    }

    // Eliminar registro
    async function deleteHistory() {
        const id = document.getElementById('deleteHistoryId').value;

        try {
            const response = await fetch('/BackupHistory/Delete?id=' + id, {
                method: 'POST'
            });
            const result = await response.json();

            const modal = bootstrap.Modal.getInstance(document.getElementById('deleteModal'));
            modal.hide();

            if (result.success) {
                showToast('success', result.message);
                setTimeout(() => location.reload(), 1500);
            } else {
                showToast('error', result.message);
            }
        } catch (error) {
            showToast('error', 'Error al eliminar: ' + error.message);
        }
    }

    // Confirmar limpiar todo
    function confirmClearAll() {
        const modal = new bootstrap.Modal(document.getElementById('clearAllModal'));
        modal.show();
    }

    // Limpiar todo el historial
    async function clearAll() {
        try {
            const response = await fetch('/BackupHistory/ClearAll', {
                method: 'POST'
            });
            const result = await response.json();

            const modal = bootstrap.Modal.getInstance(document.getElementById('clearAllModal'));
            modal.hide();

            if (result.success) {
                showToast('success', result.message);
                setTimeout(() => location.reload(), 1500);
            } else {
                showToast('error', result.message);
            }
        } catch (error) {
            showToast('error', 'Error al limpiar historial: ' + error.message);
        }
    }
</script>

<style>
    .table-hover tbody tr:hover {
        background-color: rgba(13, 110, 253, 0.05);
    }

    .badge {
        padding: 0.5em 0.75em;
        font-weight: 500;
    }

    .pagination .page-link {
        border-radius: 0.375rem;
        margin: 0 2px;
    }

    .pagination .page-item.active .page-link {
        background-color: #0d6efd;
        border-color: #0d6efd;
    }
</style>
