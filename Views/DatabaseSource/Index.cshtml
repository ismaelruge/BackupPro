@model IEnumerable<BackupPro.Models.DatabaseSource>
@{
    ViewData["Title"] = "Bases de datos a respaldar";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between mb-3">
        <h2 class="text-primary"><i class="bi bi-server me-2"></i> Bases de datos a respaldar</h2>
        <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#modalDatabase"
                onclick="openCreateModal()" aria-label="Agregar nueva base de datos">
            <i class="bi bi-plus-circle me-1"></i> Nueva Base de Datos
        </button>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" role="alert">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle" aria-label="Listado de bases de datos">
            <thead class="table-dark">
                <tr>
                    <th scope="col">Nombre</th>
                    <th scope="col">Tipo</th>
                    <th scope="col">Servidor</th>
                    <th scope="col">Base seleccionada</th>
                    <th scope="col" class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var db in Model)
                {
                    <tr>
                        <td>@db.Name</td>
                        <td>@db.Type</td>
                        <td>@db.Server</td>
                        <td>@db.DatabaseName</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-primary me-2"
                                    data-bs-toggle="modal" data-bs-target="#modalDatabase"
                                    onclick="openEditModal(@db.Id, '@db.Name', '@db.Type', '@db.Server', '@db.DatabaseName', '@db.User', '@db.Password', @(db.UseWindowsAuth.ToString().ToLower()), '@(db.BackupName)')"
                                    aria-label="Editar base de datos @db.Name">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                            <button class="btn btn-sm btn-danger"
                                    data-bs-toggle="modal" data-bs-target="#modalDelete"
                                    onclick="setDeleteId(@db.Id)" aria-label="Eliminar base de datos @db.Name">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Crear/Editar -->
<div class="modal fade" id="modalDatabase" tabindex="-1" aria-labelledby="modalDatabaseLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="databaseForm" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalDatabaseLabel">Agregar Base de Datos</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="dbId" name="Id" />

                    <div class="mb-3">
                        <label class="form-label">Nombre descriptivo</label>
                        <input type="text" id="dbName" name="Name" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Tipo</label>
                        <select id="dbType" name="Type" class="form-select" onchange="onTypeChange()">
                            <option value="SQLServer">SQL Server</option>
                            <option value="PostgreSQL">PostgreSQL</option>
                            <option value="MySQL">MySQL</option>
                            <option value="MongoDB">MongoDB</option>
                        </select>
                    </div>

                    <!-- Servidor -->
                    <div class="mb-3">
                        <label class="form-label">Servidor</label>
                        <input type="text" id="dbServer" name="Server" class="form-control" placeholder="Ej: localhost, instancia o IP" required />
                    </div>

                    <!-- Autenticación SQL Server -->
                    <div id="authSection" class="mb-3">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="useWindowsAuth" name="UseWindowsAuth" onchange="toggleAuth()">
                            <label class="form-check-label" for="useWindowsAuth">Usar autenticación de Windows</label>
                        </div>
                        <div id="userPassFields">
                            <label class="form-label">Usuario</label>
                            <input type="text" id="dbUser" name="User" class="form-control mb-2" />
                            <label class="form-label">Contraseña</label>
                            <input type="password" id="dbPassword" name="Password" class="form-control" />
                        </div>
                    </div>

                    <!-- Listar bases de datos -->
                    <div class="mb-3">
                        <button type="button" class="btn btn-outline-primary btn-sm mb-2" onclick="listarBases()">Listar Bases de Datos</button>
                        <select id="dbDatabaseName" name="DatabaseName" class="form-select">
                            <option value="">Seleccione la base de datos</option>
                        </select>
                    </div>

                    <!-- Nombre del respaldo -->
                    <div class="mb-3">
                        <label class="form-label">Nombre del archivo de respaldo</label>
                        <input type="text" id="dbBackupName" name="BackupName" class="form-control" placeholder="Ej: respaldo_empresa.bak" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Confirmación Eliminar -->
<div class="modal fade" id="modalDelete" tabindex="-1" aria-labelledby="modalDeleteLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" id="deleteForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalDeleteLabel">Confirmar Eliminación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-danger">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        ¿Estás seguro de eliminar esta base de datos?
                    </p>
                    <input type="hidden" id="deleteId" name="id" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleAuth() {
            const useWindowsAuth = document.getElementById("useWindowsAuth").checked;
            document.getElementById("userPassFields").style.display = useWindowsAuth ? "none" : "block";
        }

        function onTypeChange() {
            const type = document.getElementById("dbType").value;
            const authSection = document.getElementById("authSection");

            // Solo SQL Server usa autenticación Windows
            authSection.style.display = type === "SQLServer" ? "block" : "none";
        }

        function listarBases() {
            const type = document.getElementById("dbType").value;
            const server = document.getElementById("dbServer").value;
            const user = document.getElementById("dbUser").value;
            const password = document.getElementById("dbPassword").value;
            const windowsAuth = document.getElementById("useWindowsAuth").checked;

            fetch(`/DatabaseSource/ListDatabases?type=${type}&server=${server}&user=${user}&password=${password}&windowsAuth=${windowsAuth}`)
                .then(res => res.json())
                .then(data => {
                    const dbSelect = document.getElementById("dbDatabaseName");
                    dbSelect.innerHTML = "";
                    data.forEach(db => {
                        const opt = document.createElement("option");
                        opt.value = db;
                        opt.text = db;
                        dbSelect.appendChild(opt);
                    });
                })
                .catch(err => alert("Error listando bases de datos: " + err));
        }

        function openCreateModal() {
            document.getElementById("modalDatabaseLabel").innerText = "Agregar Base de Datos";
            document.getElementById("databaseForm").action = "/DatabaseSource/Create";
            document.getElementById("databaseForm").reset();
            toggleAuth();
        }

        function openEditModal(id, name, type, server, database, user, password, windowsAuth, BackupName) {
            document.getElementById("modalDatabaseLabel").innerText = "Editar Base de Datos";
            document.getElementById("databaseForm").action = "/DatabaseSource/Edit";

            document.getElementById("dbId").value = id;
            document.getElementById("dbName").value = name;
            document.getElementById("dbType").value = type;
            document.getElementById("dbServer").value = server;
            document.getElementById("dbDatabaseName").innerHTML = `<option value="${database}" selected>${database}</option>`;
            document.getElementById("dbUser").value = user;
            document.getElementById("dbPassword").value = password;
            document.getElementById("useWindowsAuth").checked = windowsAuth;
            document.getElementById("dbBackupName").value = BackupName;

            toggleAuth();
        }

        function setDeleteId(id) {
            document.getElementById("deleteId").value = id;
            document.getElementById("deleteForm").action = "/DatabaseSource/Delete/" + id;
        }
    </script>
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
