        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .rounded-circle {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Estilos del explorador FTP */
    .ftp-folder-item {
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .ftp-folder-item:hover {
            background-color: rgba(13, 110, 253, 0.1);
