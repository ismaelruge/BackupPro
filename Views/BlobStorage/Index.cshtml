@model IEnumerable<BackupPro.Models.AzureBlobStorage>
@{
    ViewData["Title"] = "Blob Storage";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">
            <!-- Card principal -->
            <div class="card shadow-lg border-0 rounded-4">
                <!-- Header -->
                <div class="card-header bg-primary text-white border-0 rounded-top-4 py-4">
                    <div class="text-center">
                        <i class="bi bi-cloud-arrow-up fs-1 mb-3"></i>
                        <h3 class="fw-bold mb-2">Tipos de Almacenamiento</h3>
                        <p class="mb-0 opacity-75">Configura múltiples destinos donde se guardarán tus backups</p>
                    </div>
                </div>

                <!-- Cuerpo con pestañas -->
                <div class="card-body p-4">
                    <!-- Nav Tabs -->
                    <ul class="nav nav-pills nav-fill mb-4" id="storageTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <a class="nav-link" id="google-tab" role="tab" asp-area="" asp-controller="GoogleDriveStorage" asp-action="Index">
                                <i class="bi bi-google me-2"></i>Google Drive
                            </a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link" id="onedrive-tab" role="tab" asp-area="" asp-controller="OneDriveStorage" asp-action="Index">
                                <i class="bi bi-microsoft me-2"></i>OneDrive
                            </a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link active" id="blob-tab" role="tab" asp-area="" asp-controller="BlobStorage" asp-action="Index">
                                <i class="bi bi-cloud me-2"></i>Azure Blob
                            </a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link" id="ftp-tab" role="tab" asp-area="" asp-controller="FtpStorage" asp-action="Index">
                                <i class="bi bi-hdd-network me-2"></i>FTP
                            </a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link" id="sftp-tab" role="tab" asp-area="" asp-controller="SftpStorage" asp-action="Index">
                                <i class="bi bi-shield-lock me-2"></i>SFTP
                            </a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link" id="local-tab" role="tab" asp-area="" asp-controller="LocalStorage" asp-action="Index">
                                <i class="bi bi-folder me-2"></i>Local
                            </a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link" id="s3-tab" role="tab" asp-area="" asp-controller="S3Storage" asp-action="Index">
                                <i class="bi bi-bucket me-2"></i>Amazon S3
                            </a>
                        </li>
                    </ul>

                    <!-- Tab Content -->
                    <div class="tab-content" id="storageTabContent">
                        
                        <!-- Azure Blob Storage -->
                        <div class="tab-pane fade show active" id="blob" role="tabpanel">
                            <div class="text-center mb-4">
                                <i class="bi bi-cloud text-primary" style="font-size: 3rem;"></i>
                                <h4 class="mt-3">Azure Blob Storage</h4>
                                <p class="text-muted">Configura múltiples contenedores de Azure Blob</p>
                            </div>

                            <!-- Lista de configuraciones -->
                            <div class="mb-4">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="fw-semibold mb-0">
                                        <i class="bi bi-gear-fill me-2 text-primary"></i>Configuraciones Activas
                                    </h6>
                                    <span class="badge bg-primary rounded-pill">@Model.Count() configuradas</span>
                                </div>

                                @if (!Model.Any())
                                {
                                    <div class="alert alert-info" role="alert">
                                        <i class="bi bi-info-circle me-2"></i>
                                        No hay configuraciones de Azure Blob Storage registradas. Haz clic en "Agregar Nuevo Contenedor" para comenzar.
                                    </div>
                                }
                                else
                                {
                                    @foreach (var config in Model)
                                    {
                                        <!-- Configuración -->
                                        <div class="card mb-3 border-0 shadow-sm">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <div class="flex-grow-1">
                                                        <h6 class="mb-2 fw-semibold">
                                                            <span class="text-primary">@config.ConfigurationName</span>
                                                            <span class="text-muted fw-normal"> - @config.ContainerName</span>
                                                        </h6>
                                                        <div class="ms-4">
                                                            <div class="mb-1">
                                                                <i class="bi bi-link-45deg me-2 text-muted"></i>
                                                                <small class="text-muted">Cuenta: @config.AccountName</small>
                                                            </div>
                                                            <div class="mb-1">
                                                                <i class="bi bi-folder me-2 text-muted"></i>
                                                                <span class="text-muted">Ruta:</span>
                                                                <code class="ms-1">@(string.IsNullOrEmpty(config.BlobPrefix) ? "/" : config.BlobPrefix)</code>
                                                            </div>
                                                            <span class="badge bg-success mt-1">
                                                                <i class="bi bi-check-circle me-1"></i>Activo
                                                            </span>
                                                        </div>
                                                    </div>
                                                    <div>
                                                        <button class="btn btn-sm btn-outline-primary rounded-pill me-2"
                                                                onclick="openEditModal(@config.Id)"
                                                                aria-label="Editar configuración Blob">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-danger rounded-pill"
                                                                onclick="openDeleteModal(@config.Id, '@config.ConfigurationName', '@config.ContainerName', '@(string.IsNullOrEmpty(config.BlobPrefix) ? "/" : config.BlobPrefix)')"
                                                                aria-label="Eliminar configuración Blob">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>

                            <!-- Botón agregar nueva configuración -->
                            <div class="d-grid">
                                <button type="button" class="btn btn-outline-primary btn-lg rounded-pill" data-bs-toggle="modal" data-bs-target="#addBlobModal">
                                    <i class="bi bi-plus-circle me-2"></i>Agregar Nuevo Contenedor
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Información adicional -->
            <div class="alert alert-info rounded-4 mt-4 shadow-sm" role="alert">
                <div class="d-flex align-items-center">
                    <i class="bi bi-info-circle-fill fs-3 me-3"></i>
                    <div>
                        <h6 class="mb-1 fw-semibold">Múltiples destinos</h6>
                        <p class="mb-0">Puedes configurar múltiples destinos del mismo tipo. Los backups se copiarán a todos los destinos configurados como activos.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Crear Carpeta Blob -->
<div class="modal fade" id="createBlobFolderModal" tabindex="-1" aria-labelledby="createBlobFolderModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-success text-white border-0">
                <h5 class="modal-title" id="createBlobFolderModalLabel">
                    <i class="bi bi-folder-plus me-2"></i>Nueva Carpeta Blob
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label for="newBlobFolderName" class="form-label fw-semibold">
                        <i class="bi bi-folder me-2 text-success"></i>Nombre de la carpeta
                    </label>
                    <input type="text" class="form-control" id="newBlobFolderName" placeholder="nueva_carpeta" autofocus>
                    <div class="form-text">Solo letras, números, guiones y guiones bajos</div>
                </div>
                <div class="alert alert-info rounded-3 mb-0" role="alert">
                    <i class="bi bi-info-circle me-2"></i>
                    <small>La carpeta se creará en: <strong><span id="createBlobFolderContainer"></span><span id="createBlobFolderLocation"></span></strong></small>
                </div>
            </div>
            <div class="modal-footer border-0 bg-light">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-2"></i>Cancelar
                </button>
                <button type="button" class="btn btn-success rounded-pill" id="btnConfirmCreateBlobFolder">
                    <i class="bi bi-folder-plus me-2"></i>Crear Carpeta
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Agregar Azure Blob -->
<div class="modal fade" id="addBlobModal" tabindex="-1" aria-labelledby="addBlobModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white border-0">
                <h5 class="modal-title" id="addBlobModalLabel">
                    <i class="bi bi-cloud me-2"></i>Agregar Azure Blob Storage
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4">
                <form id="addBlobForm">
                    <div class="mb-3">
                        <label for="blobConfigName" class="form-label fw-semibold">
                            <i class="bi bi-tag me-2 text-primary"></i>Nombre de Configuración
                        </label>
                        <input type="text" class="form-control" id="blobConfigName" placeholder="Ej: Azure Principal" required>
                        <div class="form-text">Dale un nombre descriptivo a esta configuración</div>
                    </div>
                    <div class="mb-3">
                        <label for="blobAccountName" class="form-label fw-semibold">
                            <i class="bi bi-person-circle me-2 text-primary"></i>Nombre de la Cuenta
                        </label>
                        <input type="text" class="form-control" id="blobAccountName" placeholder="myazureaccount" required>
                        <div class="form-text">Nombre de la cuenta de Azure Storage</div>
                    </div>
                    <div class="mb-3">
                        <label for="blobConnectionString" class="form-label fw-semibold">
                            <i class="bi bi-link-45deg me-2 text-primary"></i>Connection String
                        </label>
                        <textarea class="form-control" id="blobConnectionString" rows="3" placeholder="DefaultEndpointsProtocol=https;AccountName=..." required></textarea>
                        <div class="form-text">Cadena de conexión de Azure Storage Account</div>
                    </div>
                    <div class="mb-3">
                        <label for="blobContainer" class="form-label fw-semibold">
                            <i class="bi bi-box me-2 text-primary"></i>Contenedor
                        </label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="blobContainer" placeholder="nombre-contenedor" required readonly>
                            <button class="btn btn-outline-secondary" type="button" id="btnExploreBlobContainer">
                                <i class="bi bi-box-arrow-in-down me-1"></i>Seleccionar
                            </button>
                        </div>
                        <div class="form-text">Nombre del contenedor en Azure Storage</div>
                    </div>
                    <div class="mb-3">
                        <label for="blobPath" class="form-label fw-semibold">
                            <i class="bi bi-folder me-2 text-primary"></i>Ruta
                        </label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="blobPath" placeholder="folder/subfolder" readonly>
                            <button class="btn btn-outline-secondary" type="button" id="btnExploreBlob" disabled>
                                <i class="bi bi-folder2-open me-1"></i>Explorar
                            </button>
                        </div>
                        <div class="form-text">Ruta dentro del contenedor (se debe seleccionar el contenedor primero)</div>
                    </div>
                    <div class="alert alert-warning rounded-3 mb-0" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <small><strong>Nota:</strong> Asegúrate de tener los permisos necesarios en el contenedor de Azure.</small>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 bg-light">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-2"></i>Cancelar
                </button>
                <button type="submit" form="addBlobForm" class="btn btn-primary rounded-pill">
                    <i class="bi bi-cloud me-2"></i>Conectar Azure Blob
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Editar Azure Blob -->
<div class="modal fade" id="editBlobModal" tabindex="-1" aria-labelledby="editBlobModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-warning text-dark border-0">
                <h5 class="modal-title" id="editBlobModalLabel">
                    <i class="bi bi-pencil-square me-2"></i>Editar Azure Blob Storage
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4">
                <form id="editBlobForm">
                    <input type="hidden" id="editBlobId">
                    <input type="hidden" id="editBlobCurrentConnectionString">
                    <div class="mb-3">
                        <label for="editBlobConfigName" class="form-label fw-semibold">
                            <i class="bi bi-tag me-2 text-warning"></i>Nombre de Configuración
                        </label>
                        <input type="text" class="form-control" id="editBlobConfigName" required>
                    </div>
                    <div class="mb-3">
                        <label for="editBlobAccountName" class="form-label fw-semibold">
                            <i class="bi bi-person-circle me-2 text-warning"></i>Nombre de la Cuenta
                        </label>
                        <input type="text" class="form-control" id="editBlobAccountName" required>
                        <div class="form-text">Nombre de la cuenta de Azure Storage</div>
                    </div>
                    <div class="mb-3">
                        <label for="editBlobConnectionString" class="form-label fw-semibold">
                            <i class="bi bi-link-45deg me-2 text-warning"></i>Connection String
                        </label>
                        <textarea class="form-control" id="editBlobConnectionString" rows="3" placeholder="Dejar vacío para mantener la actual" ></textarea>
                        <div class="form-text">Dejar vacío para mantener la conexión actual</div>
                    </div>
                    <div class="mb-3">
                        <label for="editBlobContainer" class="form-label fw-semibold">
                            <i class="bi bi-box me-2 text-warning"></i>Contenedor
                        </label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="editBlobContainer" required readonly>
                            <button class="btn btn-outline-secondary" type="button" id="btnExploreEditBlobContainer">
                                <i class="bi bi-box-arrow-in-down me-1"></i>Seleccionar
                            </button>
                        </div>
                        <div class="form-text">Nombre del contenedor en Azure Storage</div>
                    </div>
                    <div class="mb-3">
                        <label for="editBlobPath" class="form-label fw-semibold">
                            <i class="bi bi-folder me-2 text-warning"></i>Ruta
                        </label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="editBlobPath" readonly>
                            <button class="btn btn-outline-secondary" type="button" id="btnExploreEditBlob" disabled>
                                <i class="bi bi-folder2-open me-1"></i>Explorar
                            </button>
                        </div>
                        <div class="form-text">Ruta dentro del contenedor (se debe seleccionar el contenedor primero)</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 bg-light">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-2"></i>Cancelar
                </button>
                <button type="submit" form="editBlobForm" class="btn btn-warning rounded-pill">
                    <i class="bi bi-save me-2"></i>Guardar Cambios
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Eliminar Azure Blob -->
<div class="modal fade" id="deleteBlobModal" tabindex="-1" aria-labelledby="deleteBlobModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-danger text-white border-0">
                <h5 class="modal-title" id="deleteBlobModalLabel">
                    <i class="bi bi-exclamation-triangle me-2"></i>Confirmar Eliminación
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4">
                <div class="text-center mb-4">
                    <div class="bg-danger bg-opacity-10 rounded-circle p-3 d-inline-flex mb-3">
                        <i class="bi bi-trash text-danger" style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="fw-semibold">¿Estás seguro de eliminar esta configuración?</h5>
                </div>
                <div class="bg-light rounded-3 p-3 mb-3">
                    <div class="mb-2">
                        <strong class="text-primary" id="deleteBlobConfigName"></strong>
                        <span class="text-muted"> - <span id="deleteBlobContainer"></span></span>
                    </div>
                    <div class="text-muted">
                        <small>
                            <i class="bi bi-folder me-2"></i>
                            Ruta: <code id="deleteBlobPath"></code>
                        </small>
                    </div>
                </div>
                <div class="alert alert-danger rounded-3 mb-0" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <strong>Advertencia:</strong> Esta acción no se puede deshacer. Los backups existentes en Azure Blob Storage no serán eliminados, solo se removerá la configuración de este sistema.
                </div>
            </div>
            <div class="modal-footer border-0 bg-light">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-2"></i>Cancelar
                </button>
                <button type="button" class="btn btn-danger rounded-pill" id="btnConfirmDeleteBlob">
                    <i class="bi bi-trash me-2"></i>Sí, Eliminar Configuración
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Explorador Azure Blob -->
<div class="modal fade" id="blobExplorerModal" tabindex="-1" aria-labelledby="blobExplorerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white border-0">
                <h5 class="modal-title" id="blobExplorerModalLabel">
                    <i class="bi bi-cloud me-2"></i>Explorador de Azure Blob Storage
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Paso 1: Seleccionar Contenedor -->
                <div id="blobContainerStep">
                    <h6 class="fw-semibold mb-3">
                        <i class="bi bi-box me-2 text-primary"></i>Paso 1: Seleccionar Contenedor
                    </h6>

                    <!-- Loading -->
                    <div id="blobContainerLoading" class="text-center py-5 d-none">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Cargando...</span>
                        </div>
                        <p class="mt-3 text-muted">Cargando contenedores...</p>
                    </div>

                    <!-- Error -->
                    <div id="blobContainerError" class="alert alert-danger d-none" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <span id="blobContainerErrorMessage"></span>
                    </div>

                    <!-- Lista de contenedores -->
                    <div id="blobContainerList" class="border rounded-3 bg-light" style="max-height: 300px; overflow-y: auto;">
                        <!-- Los contenedores se cargarán aquí -->
                    </div>
                </div>

                <!-- Paso 2: Navegar por Carpetas -->
                <div id="blobFolderStep" class="d-none">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-semibold mb-0">
                            <i class="bi bi-folder me-2 text-primary"></i>Paso 2: Seleccionar Carpeta
                        </h6>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnBackToContainers">
                            <i class="bi bi-arrow-left me-1"></i>Cambiar Contenedor
                        </button>
                    </div>

                    <!-- Breadcrumb de navegación -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <nav aria-label="breadcrumb" class="flex-grow-1">
                                <ol class="breadcrumb mb-0" id="blobBreadcrumb">
                                    <li class="breadcrumb-item active">
                                        <i class="bi bi-box me-1"></i>
                                        <span id="blobCurrentContainer"></span>
                                    </li>
                                </ol>
                            </nav>
                            <button type="button" class="btn btn-sm btn-success" id="btnCreateBlobFolder">
                                <i class="bi bi-folder-plus me-1"></i>Nueva Carpeta
                            </button>
                        </div>
                    </div>

                    <!-- Contenedor de carpetas -->
                    <div class="border rounded-3 bg-light" style="min-height: 300px; max-height: 300px; overflow-y: auto;">
                        <!-- Loading -->
                        <div id="blobFolderLoading" class="text-center py-5 d-none">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            <p class="mt-3 text-muted">Cargando carpetas...</p>
                        </div>

                        <!-- Error -->
                        <div id="blobFolderError" class="alert alert-danger m-3 d-none" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            <span id="blobFolderErrorMessage"></span>
                        </div>

                        <!-- Lista de carpetas -->
                        <div id="blobFolderList" class="list-group list-group-flush">
                            <!-- Las carpetas se cargarán aquí -->
                        </div>

                        <!-- Empty state -->
                        <div id="blobFolderEmpty" class="text-center py-5 d-none">
                            <i class="bi bi-folder-x text-muted" style="font-size: 3rem;"></i>
                            <p class="mt-3 text-muted">No hay subcarpetas en este directorio</p>
                            <small class="text-muted">Puedes seleccionar esta ubicación para guardar tus backups</small>
                        </div>
                    </div>
                </div>

                <!-- Selección actual -->
                <div class="mt-3">
                    <div class="row">
                        <div class="col-md-6 mb-2 mb-md-0">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-box me-2 text-primary"></i>Contenedor seleccionado:
                            </label>
                            <input type="text" class="form-control" id="blobSelectedContainer" readonly>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-folder me-2 text-success"></i>Ruta seleccionada:
                            </label>
                            <input type="text" class="form-control" id="blobSelectedPath" readonly placeholder="/">
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 bg-light">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-2"></i>Cancelar
                </button>
                <button type="button" class="btn btn-primary rounded-pill" id="btnSelectBlobPath">
                    <i class="bi bi-check-circle me-2"></i>Seleccionar Ubicación
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .nav-pills .nav-link {
        border-radius: 50rem;
        padding: 0.75rem 1.5rem;
        font-weight: 500;
        transition: all 0.3s ease;
    }

        .nav-pills .nav-link:hover {
            background-color: rgba(13, 110, 253, 0.1);
            transform: translateY(-2px);
        }

        .nav-pills .nav-link.active {
            background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
            box-shadow: 0 4px 6px rgba(13, 110, 253, 0.3);
        }

    .tab-pane {
        animation: fadeIn 0.3s ease-in;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
