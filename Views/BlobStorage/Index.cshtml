</style>

<!-- Contenedor de toasts -->
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 2000;">
    <div id="successToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                <i class="bi bi-check-circle me-2"></i>
                <span id="successToastMessage"></span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
    <div id="errorToast" class="toast align-items-center text-white bg-danger border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                <i class="bi bi-exclamation-triangle me-2"></i>
                <span id="errorToastMessage"></span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
    <div id="warningToast" class="toast align-items-center text-white bg-warning border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                <i class="bi bi-info-circle me-2"></i>
                <span id="warningToastMessage"></span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<script>
    // Función helper para mostrar toasts
    function showToast(type, message) {
        const toastElement = document.getElementById(type + 'Toast');
        const messageElement = document.getElementById(type + 'ToastMessage');
        messageElement.textContent = message;

        const toast = new bootstrap.Toast(toastElement, {
            autohide: true,
            delay: 3000
        });
        toast.show();
    }
    
    // ========== AZURE BLOB STORAGE EXPLORER ==========

    // Variables globales para el explorador Blob
    let blobExplorerData = {
        connectionString: '',
        selectedContainer: '',
        currentPath: '',
        isEditMode: false,
        selectingContainerOnly: false
    };

    // Abrir explorador de contenedores desde modal de agregar
    document.getElementById('btnExploreBlobContainer')?.addEventListener('click', function() {
        openBlobExplorer(false, true);
    });

    // Abrir explorador de rutas desde modal de agregar
    document.getElementById('btnExploreBlob')?.addEventListener('click', function() {
        openBlobExplorer(false, false);
    });

    // Abrir explorador de contenedores desde modal de editar
    document.getElementById('btnExploreEditBlobContainer')?.addEventListener('click', function() {
        openBlobExplorer(true, true);
    });

    // Abrir explorador de rutas desde modal de editar
    document.getElementById('btnExploreEditBlob')?.addEventListener('click', function() {
        openBlobExplorer(true, false);
    });

    // Función para abrir el explorador Blob
    function openBlobExplorer(isEditMode, selectingContainerOnly) {
        const connStrInput = isEditMode ? 'editBlobConnectionString' : 'blobConnectionString';
        let connectionString = document.getElementById(connStrInput).value;

        // Si estamos en modo edición y no hay connection string visible, usar la actual
        if (isEditMode && !connectionString) {
            connectionString = document.getElementById('editBlobCurrentConnectionString').value;
        }

        if (!connectionString) {
            showToast('warning', 'Por favor, ingresa el Connection String antes de explorar.');
            return;
        }

        // Si estamos seleccionando rutas, verificar que haya un contenedor seleccionado
        if (!selectingContainerOnly) {
            const containerInput = isEditMode ? 'editBlobContainer' : 'blobContainer';
            const container = document.getElementById(containerInput).value;

            if (!container) {
                showToast('warning', 'Por favor, selecciona un contenedor primero.');
                return;
            }

            // Guardar datos con el contenedor ya seleccionado
            blobExplorerData = {
                connectionString: connectionString,
                selectedContainer: container,
                currentPath: '',
                isEditMode: isEditMode,
                selectingContainerOnly: false
            };

            // Ir directo al paso 2 (carpetas)
            document.getElementById('blobContainerStep').classList.add('d-none');
            document.getElementById('blobFolderStep').classList.remove('d-none');
            document.getElementById('blobCurrentContainer').textContent = container;
            document.getElementById('blobSelectedContainer').value = container;
            document.getElementById('blobSelectedPath').value = '/';

            // Abrir modal
            const explorerModal = new bootstrap.Modal(document.getElementById('blobExplorerModal'));
            explorerModal.show();

            // Cargar carpetas del contenedor
            loadBlobDirectories('');
        } else {
            // Seleccionando contenedor
            blobExplorerData = {
                connectionString: connectionString,
                selectedContainer: '',
                currentPath: '',
                isEditMode: isEditMode,
                selectingContainerOnly: true
            };

            // Resetear UI - mostrar paso 1 (contenedores)
            document.getElementById('blobContainerStep').classList.remove('d-none');
            document.getElementById('blobFolderStep').classList.add('d-none');
            document.getElementById('blobSelectedContainer').value = '';
            document.getElementById('blobSelectedPath').value = '';

            // Abrir modal
            const explorerModal = new bootstrap.Modal(document.getElementById('blobExplorerModal'));
            explorerModal.show();

            // Cargar contenedores
            loadBlobContainers();
        }
    }

    // Función para cargar contenedores
    async function loadBlobContainers() {
        showBlobContainerState('loading');

        try {
            const response = await fetch('/BlobStorage/ListBlobContainers', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                },
                body: JSON.stringify({
                    connectionString: blobExplorerData.connectionString
                })
            });

            const data = await response.json();

            if (data.success) {
                displayBlobContainers(data.containers);
            } else {
                showBlobContainerState('error', data.message);
            }
        } catch (error) {
            showBlobContainerState('error', 'Error de conexión: ' + error.message);
        }
    }

    // Función para mostrar estados del contenedor
    function showBlobContainerState(state, message = '') {
        const loading = document.getElementById('blobContainerLoading');
        const error = document.getElementById('blobContainerError');
        const list = document.getElementById('blobContainerList');

        loading.classList.add('d-none');
        error.classList.add('d-none');

        switch(state) {
            case 'loading':
                loading.classList.remove('d-none');
                list.innerHTML = '';
                break;
            case 'error':
                error.classList.remove('d-none');
                document.getElementById('blobContainerErrorMessage').textContent = message;
                list.innerHTML = '';
                break;
            case 'success':
                // Mostrar lista
                break;
        }
    }

    // Función para mostrar contenedores
    function displayBlobContainers(containers) {
        const list = document.getElementById('blobContainerList');
        list.innerHTML = '';

        if (containers.length === 0) {
            list.innerHTML = '<div class="text-center py-4"><p class="text-muted">No hay contenedores disponibles</p></div>';
            return;
        }

        showBlobContainerState('success');

        const listGroup = document.createElement('div');
        listGroup.className = 'list-group list-group-flush';

        containers.forEach(container => {
            const item = document.createElement('a');
            item.href = '#';
            item.className = 'list-group-item list-group-item-action blob-container-item';

            item.innerHTML = `
                <div class="d-flex align-items-center">
                    <i class="bi bi-box-fill me-3 text-primary fs-5"></i>
                    <div class="flex-grow-1">
                        <div class="fw-semibold">${container.name}</div>
                        <small class="text-muted">Última modificación: ${new Date(container.lastModified).toLocaleDateString()}</small>
                    </div>
                    <i class="bi bi-chevron-right text-muted"></i>
                </div>
            `;

            item.addEventListener('click', function(e) {
                e.preventDefault();
                selectContainer(container.name);
            });

            listGroup.appendChild(item);
        });

        list.appendChild(listGroup);
    }

    // Función para seleccionar contenedor
    function selectContainer(containerName) {
        blobExplorerData.selectedContainer = containerName;
        blobExplorerData.currentPath = '';

        // Actualizar campos separados
        document.getElementById('blobSelectedContainer').value = containerName;
        document.getElementById('blobSelectedPath').value = '/';

        // Si solo estamos seleccionando contenedor, asignar y cerrar modal
        if (blobExplorerData.selectingContainerOnly) {
            // Asignar al campo correcto según el modo
            if (blobExplorerData.isEditMode) {
                document.getElementById('editBlobContainer').value = containerName;
                // Habilitar botón de explorar ruta
                document.getElementById('btnExploreEditBlob').disabled = false;
            } else {
                document.getElementById('blobContainer').value = containerName;
                // Habilitar botón de explorar ruta
                document.getElementById('btnExploreBlob').disabled = false;
            }

            // Cerrar modal
            const explorerModal = bootstrap.Modal.getInstance(document.getElementById('blobExplorerModal'));
            explorerModal.hide();
        } else {
            // Cambiar a paso 2 para seleccionar ruta
            document.getElementById('blobContainerStep').classList.add('d-none');
            document.getElementById('blobFolderStep').classList.remove('d-none');
            document.getElementById('blobCurrentContainer').textContent = containerName;

            // Cargar carpetas del contenedor
            loadBlobDirectories('');
        }
    }

    // Botón para volver a contenedores
    document.getElementById('btnBackToContainers')?.addEventListener('click', function() {
        document.getElementById('blobFolderStep').classList.add('d-none');
        document.getElementById('blobContainerStep').classList.remove('d-none');
        blobExplorerData.selectedContainer = '';
        blobExplorerData.currentPath = '';
    });

    // Función para cargar directorios de Blob
    async function loadBlobDirectories(path) {
        blobExplorerData.currentPath = path;
        showBlobFolderState('loading');

        try {
            const response = await fetch('/BlobStorage/ListBlobDirectories', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                },
                body: JSON.stringify({
                    connectionString: blobExplorerData.connectionString,
                    containerName: blobExplorerData.selectedContainer,
                    path: path
                })
            });

            const data = await response.json();

            if (data.success) {
                displayBlobDirectories(data.directories, data.currentPath);
                updateBlobBreadcrumb(data.currentPath);
            } else {
                showBlobFolderState('error', data.message);
            }
        } catch (error) {
            showBlobFolderState('error', 'Error de conexión: ' + error.message);
        }
    }

    // Función para mostrar estados de carpetas
    function showBlobFolderState(state, message = '') {
        const loading = document.getElementById('blobFolderLoading');
        const error = document.getElementById('blobFolderError');
        const folderList = document.getElementById('blobFolderList');
        const empty = document.getElementById('blobFolderEmpty');

        loading.classList.add('d-none');
        error.classList.add('d-none');
        folderList.classList.add('d-none');
        empty.classList.add('d-none');

        switch(state) {
            case 'loading':
                loading.classList.remove('d-none');
                break;
            case 'error':
                error.classList.remove('d-none');
                document.getElementById('blobFolderErrorMessage').textContent = message;
                break;
            case 'empty':
                empty.classList.remove('d-none');
                folderList.classList.remove('d-none');
                break;
            case 'success':
                folderList.classList.remove('d-none');
                break;
        }
    }

    // Función para mostrar directorios Blob
    function displayBlobDirectories(directories, currentPath) {
        const folderList = document.getElementById('blobFolderList');
        folderList.innerHTML = '';

        // Botón para volver atrás (si no estamos en raíz del contenedor)
        if (currentPath) {
            const parentPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
            const backItem = createBlobFolderItem('..', parentPath, true);
            folderList.appendChild(backItem);
        }

        // Mostrar carpetas
        if (directories.length === 0) {
            showBlobFolderState('empty');
            updateSelectedBlobPath(currentPath);
        } else {
            showBlobFolderState('success');
            directories.forEach(dir => {
                const item = createBlobFolderItem(dir.name, dir.fullPath, false);
                folderList.appendChild(item);
            });
        }

        updateSelectedBlobPath(currentPath);
    }

    // Función para crear elemento de carpeta Blob
    function createBlobFolderItem(name, fullPath, isBack) {
        const item = document.createElement('a');
        item.href = '#';
        item.className = 'list-group-item list-group-item-action blob-folder-item';

        const icon = isBack ? 'bi-arrow-left-circle' : 'bi-folder-fill';
        const text = isBack ? 'Volver atrás' : name;

        item.innerHTML = `
            <div class="d-flex align-items-center">
                <i class="bi ${icon} me-3 text-primary fs-5"></i>
                <div class="flex-grow-1">
                    <div class="fw-semibold">${text}</div>
                    ${!isBack ? `<small class="text-muted">${fullPath}</small>` : ''}
                </div>
                <i class="bi bi-chevron-right text-muted"></i>
            </div>
        `;

        item.addEventListener('click', function(e) {
            e.preventDefault();
            loadBlobDirectories(fullPath);
        });

        item.addEventListener('dblclick', function(e) {
            e.preventDefault();
            loadBlobDirectories(fullPath);
        });

        // Marcar como seleccionado
        item.addEventListener('click', function() {
            document.querySelectorAll('.blob-folder-item').forEach(el => {
                el.classList.remove('selected');
            });
            if (!isBack) {
                this.classList.add('selected');
                updateSelectedBlobPath(fullPath);
            }
        });

        return item;
    }

    // Función para actualizar breadcrumb Blob
    function updateBlobBreadcrumb(path) {
        const breadcrumb = document.getElementById('blobBreadcrumb');
        breadcrumb.innerHTML = '';

        // Contenedor (raíz)
        const containerItem = document.createElement('li');
        containerItem.className = 'breadcrumb-item breadcrumb-link';
        containerItem.innerHTML = `<i class="bi bi-box me-1"></i>${blobExplorerData.selectedContainer}`;
        containerItem.addEventListener('click', () => loadBlobDirectories(''));
        breadcrumb.appendChild(containerItem);

        // Partes del path
        if (path) {
            const parts = path.split('/').filter(p => p);
            let accumulatedPath = '';

            parts.forEach((part, index) => {
                accumulatedPath += (accumulatedPath ? '/' : '') + part;
                const pathItem = document.createElement('li');

                if (index === parts.length - 1) {
                    pathItem.className = 'breadcrumb-item active';
                    pathItem.textContent = part;
                } else {
                    pathItem.className = 'breadcrumb-item breadcrumb-link';
                    pathItem.textContent = part;
                    const pathToLoad = accumulatedPath;
                    pathItem.addEventListener('click', () => loadBlobDirectories(pathToLoad));
                }

                breadcrumb.appendChild(pathItem);
            });
        }
    }

    // Función para actualizar la ruta seleccionada
    function updateSelectedBlobPath(folderPath) {
        document.getElementById('blobSelectedContainer').value = blobExplorerData.selectedContainer;
        document.getElementById('blobSelectedPath').value = folderPath || '/';
    }

    // Botón para seleccionar ubicación
    document.getElementById('btnSelectBlobPath')?.addEventListener('click', function() {
        const selectedContainer = document.getElementById('blobSelectedContainer').value;
        const selectedPath = document.getElementById('blobSelectedPath').value;

        if (!selectedContainer) {
            showToast('warning', 'Por favor, selecciona un contenedor.');
            return;
        }

        // Determinar si estamos en modo agregar o editar
        if (blobExplorerData.isEditMode) {
            document.getElementById('editBlobContainer').value = selectedContainer;
            document.getElementById('editBlobPath').value = selectedPath;
        } else {
            document.getElementById('blobContainer').value = selectedContainer;
            document.getElementById('blobPath').value = selectedPath;
        }

        const explorerModal = bootstrap.Modal.getInstance(document.getElementById('blobExplorerModal'));
        explorerModal.hide();
    });

    // Botón para crear nueva carpeta Blob - abrir modal
    document.getElementById('btnCreateBlobFolder')?.addEventListener('click', function() {
        // Mostrar la ubicación actual en el modal
        const containerName = blobExplorerData.selectedContainer;
        const currentPath = blobExplorerData.currentPath || '/';

        document.getElementById('createBlobFolderContainer').textContent = containerName;
        document.getElementById('createBlobFolderLocation').textContent = currentPath;

        // Limpiar el input
        document.getElementById('newBlobFolderName').value = '';

        // Abrir modal
        const createFolderModal = new bootstrap.Modal(document.getElementById('createBlobFolderModal'));
        createFolderModal.show();
    });

    // Confirmar creación de carpeta Blob
    document.getElementById('btnConfirmCreateBlobFolder')?.addEventListener('click', async function() {
        const folderName = document.getElementById('newBlobFolderName').value.trim();

        if (!folderName) {
            showToast('warning', 'Por favor, ingresa un nombre para la carpeta.');
            return;
        }

        // Validar nombre de carpeta
        if (!/^[a-zA-Z0-9_-]+$/.test(folderName)) {
            showToast('warning', 'El nombre de la carpeta solo puede contener letras, números, guiones y guiones bajos.');
            return;
        }

        // Deshabilitar botón mientras se crea
        const btn = this;
        const originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Creando...';

        try {
            const response = await fetch('/BlobStorage/CreateBlobDirectory', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                },
                body: JSON.stringify({
                    connectionString: blobExplorerData.connectionString,
                    containerName: blobExplorerData.selectedContainer,
                    currentPath: blobExplorerData.currentPath,
                    newFolderName: folderName
                })
            });

            const data = await response.json();

            if (data.success) {
                // Cerrar modal
                const createFolderModal = bootstrap.Modal.getInstance(document.getElementById('createBlobFolderModal'));
                createFolderModal.hide();

                // Mostrar mensaje de éxito
                showToast('success', 'Carpeta creada exitosamente');

                // Recargar el directorio actual para mostrar la nueva carpeta
                loadBlobDirectories(blobExplorerData.currentPath);
            } else {
                showToast('error', 'Error al crear carpeta: ' + data.message);
            }
        } catch (error) {
            showToast('error', 'Error de conexión: ' + error.message);
        } finally {
            // Restaurar botón
            btn.disabled = false;
            btn.innerHTML = originalHtml;
        }
    });

    // Permitir crear carpeta Blob con Enter en el input
    document.getElementById('newBlobFolderName')?.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            document.getElementById('btnConfirmCreateBlobFolder').click();
        }
    });

    // ========== CRUD OPERATIONS ==========

    // Variables globales para eliminar
    let deleteBlobId = null;

    // Agregar nueva configuración de Blob Storage
    document.getElementById('addBlobForm')?.addEventListener('submit', async function(e) {
        e.preventDefault();

        const configName = document.getElementById('blobConfigName').value.trim();
        const accountName = document.getElementById('blobAccountName').value.trim();
        const connectionString = document.getElementById('blobConnectionString').value.trim();
        const container = document.getElementById('blobContainer').value.trim();
        const path = document.getElementById('blobPath').value.trim();

        if (!configName || !accountName || !connectionString || !container) {
            showToast('warning', 'Por favor, completa todos los campos requeridos.');
            return;
        }

        try {
            const response = await fetch('/BlobStorage/Create', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                },
                body: JSON.stringify({
                    ConfigurationName: configName,
                    AccountName: accountName,
                    ConnectionString: connectionString,
                    ContainerName: container,
                    BlobPrefix: path === '/' ? '' : path
                })
            });

            const data = await response.json();

            if (data.success) {
                showToast('success', data.message || 'Configuración creada exitosamente.');

                // Cerrar modal
                const addModal = bootstrap.Modal.getInstance(document.getElementById('addBlobModal'));
                addModal.hide();

                // Limpiar formulario
                document.getElementById('addBlobForm').reset();
                document.getElementById('btnExploreBlob').disabled = true;

                // Recargar página para mostrar la nueva configuración
                setTimeout(() => location.reload(), 1000);
            } else {
                showToast('error', data.message || 'Error al crear la configuración.');
            }
        } catch (error) {
            showToast('error', 'Error de conexión: ' + error.message);
        }
    });

    // Abrir modal de edición
    async function openEditModal(id) {
        try {
            const response = await fetch(`/BlobStorage/GetById?id=${id}`);
            const data = await response.json();

            if (data.success) {
                const config = data.data;

                // Cargar datos en el formulario
                document.getElementById('editBlobId').value = config.id;
                document.getElementById('editBlobConfigName').value = config.configurationName;
                document.getElementById('editBlobAccountName').value = config.accountName;
                document.getElementById('editBlobCurrentConnectionString').value = config.connectionString;
                document.getElementById('editBlobConnectionString').value = ''; // Dejar vacío por seguridad
                document.getElementById('editBlobContainer').value = config.containerName;
                document.getElementById('editBlobPath').value = config.blobPrefix || '/';

                // Habilitar botón de explorar si hay contenedor
                if (config.containerName) {
                    document.getElementById('btnExploreEditBlob').disabled = false;
                }

                // Abrir modal
                const editModal = new bootstrap.Modal(document.getElementById('editBlobModal'));
                editModal.show();
            } else {
                showToast('error', 'Error al cargar la configuración.');
            }
        } catch (error) {
            showToast('error', 'Error de conexión: ' + error.message);
        }
    }

    // Actualizar configuración de Blob Storage
    document.getElementById('editBlobForm')?.addEventListener('submit', async function(e) {
        e.preventDefault();

        const id = document.getElementById('editBlobId').value;
        const configName = document.getElementById('editBlobConfigName').value.trim();
        const accountName = document.getElementById('editBlobAccountName').value.trim();
        let connectionString = document.getElementById('editBlobConnectionString').value.trim();
        const container = document.getElementById('editBlobContainer').value.trim();
        const path = document.getElementById('editBlobPath').value.trim();

        // Si no se ingresó una nueva conexión, usar la actual
        if (!connectionString) {
            connectionString = document.getElementById('editBlobCurrentConnectionString').value;
        }

        if (!configName || !accountName || !connectionString || !container) {
            showToast('warning', 'Por favor, completa todos los campos requeridos.');
            return;
        }

        try {
            const response = await fetch('/BlobStorage/Edit', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                },
                body: JSON.stringify({
                    Id: parseInt(id),
                    ConfigurationName: configName,
                    AccountName: accountName,
                    ConnectionString: connectionString,
                    ContainerName: container,
                    BlobPrefix: path === '/' ? '' : path
                })
            });

            const data = await response.json();

            if (data.success) {
                showToast('success', data.message || 'Configuración actualizada exitosamente.');

                // Cerrar modal
                const editModal = bootstrap.Modal.getInstance(document.getElementById('editBlobModal'));
                editModal.hide();

                // Recargar página
                setTimeout(() => location.reload(), 1000);
            } else {
                showToast('error', data.message || 'Error al actualizar la configuración.');
            }
        } catch (error) {
            showToast('error', 'Error de conexión: ' + error.message);
        }
    });

    // Abrir modal de eliminación
    function openDeleteModal(id, name, container, path) {
        deleteBlobId = id;
        document.getElementById('deleteBlobConfigName').textContent = name;
        document.getElementById('deleteBlobContainer').textContent = container;
        document.getElementById('deleteBlobPath').textContent = path;

        const deleteModal = new bootstrap.Modal(document.getElementById('deleteBlobModal'));
        deleteModal.show();
    }

    // Confirmar eliminación
    document.getElementById('btnConfirmDeleteBlob')?.addEventListener('click', async function() {
        if (!deleteBlobId) {
            showToast('error', 'ID de configuración no válido.');
            return;
        }

        try {
            const response = await fetch(`/BlobStorage/Delete?id=${deleteBlobId}`, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                }
            });

            const data = await response.json();

            if (data.success) {
                showToast('success', data.message || 'Configuración eliminada exitosamente.');

                // Cerrar modal
                const deleteModal = bootstrap.Modal.getInstance(document.getElementById('deleteBlobModal'));
                deleteModal.hide();

                // Recargar página
                setTimeout(() => location.reload(), 1000);
            } else {
                showToast('error', data.message || 'Error al eliminar la configuración.');
            }
        } catch (error) {
            showToast('error', 'Error de conexión: ' + error.message);
        }
    });

</script>
