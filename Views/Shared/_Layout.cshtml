@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

<!DOCTYPE html>
<html lang="es" class="h-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BackupPro</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Cpath fill='white' d='M8 1c-.69 0-1.843.265-2.928.56-1.11.3-2.229.655-2.887.87a1.54 1.54 0 0 0-1.044 1.262c-.596 4.477.787 7.795 2.465 9.99a11.777 11.777 0 0 0 2.517 2.453c.386.273.744.482 1.048.625.28.132.581.24.829.24s.548-.108.829-.24c.304-.143.662-.352 1.048-.625a11.777 11.777 0 0 0 2.517-2.453c1.678-2.195 3.061-5.513 2.465-9.99a1.54 1.54 0 0 0-1.044-1.263 62.467 62.467 0 0 0-2.887-.87C9.843 1.266 8.69 1 8 1zm0 5a1.5 1.5 0 0 1 .5 2.915l.385 1.99a.5.5 0 0 1-.491.595h-.788a.5.5 0 0 1-.49-.595l.384-1.99A1.5 1.5 0 0 1 8 6z'/%3E%3C/svg%3E">
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BackupPro.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column h-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-shield-lock-fill me-2 fs-4"></i>
                    <span class="fs-5">BackupPro</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house-door me-1"></i> Inicio
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="CompanyConfig" asp-action="Index">
                                    <i class="bi bi-building me-1"></i> Configurar Empresa
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="GoogleDriveStorage" asp-action="Index">
                                    <i class="bi bi-cloud-arrow-up me-1"></i> Tipos de Almacenamiento
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="SqlServerDataBase" asp-action="Index">
                                    <i class="bi bi-database me-1"></i> Tipos de Bases de Datos
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="TaskScheduler" asp-action="Index">
                                    <i class="bi bi-calendar-check me-1"></i> Programador de Tareas
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="BackupHistory" asp-action="Index">
                                    <i class="bi bi-clock-history me-1"></i> Histórico
                                </a>
                            </li>
                        </ul>
                    }
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            @if (SignInManager.IsSignedIn(User))
                            {
                                <form method="post" asp-area="" asp-controller="Account" asp-action="Logout" class="d-inline">
                                    <button type="submit" class="btn btn-outline-light">
                                        <i class="bi bi-box-arrow-right me-1"></i> Cerrar Sesión
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-outline-light" data-bs-toggle="modal" data-bs-target="#loginModal">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                                </button>
                            }
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!--
        Aviso de atribución obligatorio bajo los términos de LICENSE.txt (MIT License with
        Attribution Requirement). Eliminar, ocultar o modificar el texto "Desarrollado por Ismael
        Ruge González" o el enlace a https://ismaelruge.github.io sin autorización escrita del
        autor constituye una infracción de los derechos de autor y propiedad intelectual, y puede
        dar lugar a acciones legales. Ver LICENSE.txt para el texto completo.
    -->
    <footer class="bg-dark text-white py-3 mt-auto">
        <div class="container text-center">
            <p class="mb-0" title="Aviso de atribución obligatorio bajo licencia (ver LICENSE.txt). Su eliminación constituye una infracción de derechos de autor y propiedad intelectual.">
                <i class="bi bi-c-circle me-1"></i> @DateTime.Now.Year - Desarrollado por
                <a href="https://ismaelruge.github.io" target="_blank" rel="noopener noreferrer" class="text-white fw-bold">Ismael Ruge González</a>.
                Todos los derechos reservados.
            </p>
        </div>
    </footer>

    <!-- Modal de Login -->
    <div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <!-- Header con gradiente -->
                <div class="modal-header border-0 login-header text-center flex-column py-4">
                    <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>
                    <div class="mb-3">
                        <i class="bi bi-shield-lock-fill text-white" style="font-size: 3.5rem;"></i>
                    </div>
                    <h5 class="modal-title text-white fw-bold mb-1" id="loginModalLabel">Iniciar sesión</h5>
                    <p class="text-white-50 mb-0 small">Accede a BackupPro</p>
                </div>

                <div class="modal-body p-4">
                    <!-- Errores de validación -->
                    <div id="loginErrors" class="alert alert-danger alert-dismissible fade show rounded-3 d-none" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <span id="loginErrorMessage"></span>
                        <button type="button" class="btn-close" onclick="document.getElementById('loginErrors').classList.add('d-none')"></button>
                    </div>

                    <!-- Formulario -->
                    <form id="loginForm" asp-controller="Account" asp-action="Login" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label for="modalEmail" class="form-label fw-semibold">
                                <i class="bi bi-person-fill me-2 text-primary"></i>Usuario o correo
                            </label>
                            <input type="text" class="form-control form-control-lg rounded-3" id="modalEmail" name="Email" placeholder="usuario o correo" required />
                        </div>

                        <div class="mb-3">
                            <label for="modalPassword" class="form-label fw-semibold">
                                <i class="bi bi-lock-fill me-2 text-primary"></i>Contraseña
                            </label>
                            <div class="input-group input-group-lg">
                                <input type="password" class="form-control rounded-start-3 border-end-0" id="modalPassword" name="Password" placeholder="••••••••" required />
                                <span class="input-group-text bg-white border-start-0 rounded-end-3" style="cursor: pointer;" id="modalTogglePassword">
                                    <i class="bi bi-eye-fill" id="modalToggleIcon"></i>
                                </span>
                            </div>
                        </div>

                        <div class="d-grid gap-2 mb-3">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill shadow-sm" id="loginSubmitBtn">
                                <i class="bi bi-box-arrow-in-right me-2"></i> Ingresar
                            </button>
                        </div>
                    </form>

                    <!-- Separador -->
                    <div class="position-relative mb-3">
                        <hr class="text-muted">
                        <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted small">
                            O continuar con
                        </span>
                    </div>

                    <!-- Botones de autenticación externa -->
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <form asp-controller="Account" asp-action="ExternalLogin" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="provider" value="Google" />
                                <button type="submit" class="btn btn-outline-secondary w-100 rounded-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-google me-2" viewBox="0 0 16 16">
                                        <path d="M15.545 6.558a9.42 9.42 0 0 1 .139 1.626c0 2.434-.87 4.492-2.384 5.885h.002C11.978 15.292 10.158 16 8 16A8 8 0 1 1 8 0a7.689 7.689 0 0 1 5.352 2.082l-2.284 2.284A4.347 4.347 0 0 0 8 3.166c-2.087 0-3.86 1.408-4.492 3.304a4.792 4.792 0 0 0 0 3.063h.003c.635 1.893 2.405 3.301 4.492 3.301 1.078 0 2.004-.276 2.722-.764h-.003a3.702 3.702 0 0 0 1.599-2.431H8v-3.08h7.545z"/>
                                    </svg>
                                    Google
                                </button>
                            </form>
                        </div>
                        <div class="col-6">
                            <form asp-controller="Account" asp-action="ExternalLogin" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="provider" value="Microsoft" />
                                <button type="submit" class="btn btn-outline-secondary w-100 rounded-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-microsoft me-2" viewBox="0 0 16 16">
                                        <path d="M7.462 0H0v7.19h7.462zM16 0H8.538v7.19H16zM7.462 8.211H0V16h7.462zm8.538 0H8.538V16H16z"/>
                                    </svg>
                                    Microsoft
                                </button>
                            </form>
                        </div>
                    </div>

                    <!-- Olvidaste tu contraseña -->
                    <div class="text-center">
                        <button id="modalForgotPasswordBtn" class="btn btn-link text-decoration-none text-muted" type="button" disabled>
                            <i class="bi bi-question-circle me-1"></i>
                            ¿Olvidaste tu contraseña?
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Función para mostrar alerta de login con SweetAlert2
        function showLoginAlert(event, section) {
            event.preventDefault();

            Swal.fire({
                icon: 'warning',
                title: 'Acceso Restringido',
                html: `<p>Debes iniciar sesión para acceder a <strong>${section}</strong></p>`,
                showCancelButton: true,
                confirmButtonText: '<i class="bi bi-box-arrow-in-right me-2"></i> Iniciar Sesión',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#0d6efd',
                cancelButtonColor: '#6c757d',
                customClass: {
                    confirmButton: 'btn btn-primary',
                    cancelButton: 'btn btn-secondary'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    // Abrir el modal de login
                    const loginModal = new bootstrap.Modal(document.getElementById('loginModal'));
                    loginModal.show();
                }
            });
        }

        // Script para el modal de login
        document.addEventListener('DOMContentLoaded', function() {
            const modalPassword = document.getElementById('modalPassword');
            const modalTogglePassword = document.getElementById('modalTogglePassword');
            const modalToggleIcon = document.getElementById('modalToggleIcon');
            const modalEmail = document.getElementById('modalEmail');
            const modalForgotPasswordBtn = document.getElementById('modalForgotPasswordBtn');
            const loginForm = document.getElementById('loginForm');
            const loginSubmitBtn = document.getElementById('loginSubmitBtn');

            // Mostrar error si existe en TempData
            @if (TempData["LoginError"] != null)
            {
                <text>
                const loginModal = new bootstrap.Modal(document.getElementById('loginModal'));
                loginModal.show();
                const errorDiv = document.getElementById('loginErrors');
                const errorMessage = document.getElementById('loginErrorMessage');
                errorMessage.textContent = '@Html.Raw(TempData["LoginError"])';
                errorDiv.classList.remove('d-none');
                </text>
            }

            // Mostrar/Ocultar contraseña
            if (modalTogglePassword) {
                modalTogglePassword.addEventListener('click', function() {
                    const type = modalPassword.getAttribute('type') === 'password' ? 'text' : 'password';
                    modalPassword.setAttribute('type', type);

                    if (type === 'text') {
                        modalToggleIcon.classList.remove('bi-eye-fill');
                        modalToggleIcon.classList.add('bi-eye-slash-fill');
                    } else {
                        modalToggleIcon.classList.remove('bi-eye-slash-fill');
                        modalToggleIcon.classList.add('bi-eye-fill');
                    }
                });
            }

            // Habilitar el botón de "Olvidaste tu contraseña" solo si el email es válido
            if (modalEmail && modalForgotPasswordBtn) {
                modalEmail.addEventListener('input', function() {
                    if (modalEmail.validity.valid && modalEmail.value.trim() !== '') {
                        modalForgotPasswordBtn.disabled = false;
                    } else {
                        modalForgotPasswordBtn.disabled = true;
                    }
                });

                modalForgotPasswordBtn.addEventListener('click', function() {
                    if (!modalEmail.validity.valid) {
                        return;
                    }

                    // Envía un POST con token antifalsificación (ya no es una navegación GET, para evitar CSRF)
                    const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                    const form = document.createElement('form');
                    form.method = 'POST';
                    form.action = '/Home/ForgotPassword';
                    form.style.display = 'none';

                    const tokenField = document.createElement('input');
                    tokenField.type = 'hidden';
                    tokenField.name = '__RequestVerificationToken';
                    tokenField.value = tokenInput ? tokenInput.value : '';
                    form.appendChild(tokenField);

                    const emailField = document.createElement('input');
                    emailField.type = 'hidden';
                    emailField.name = 'email';
                    emailField.value = modalEmail.value;
                    form.appendChild(emailField);

                    document.body.appendChild(form);
                    form.submit();
                });
            }

            // El formulario se envía normalmente (sin JavaScript) para que las cookies funcionen
            // Solo agregamos el spinner visual
            if (loginForm && loginSubmitBtn) {
                loginForm.addEventListener('submit', function(e) {
                    loginSubmitBtn.disabled = true;
                    loginSubmitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Ingresando...';
                });
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

    @* Sistema de notificaciones toast estandarizado *@
    @await Html.PartialAsync("_ToastNotification")
</body>
</html>
